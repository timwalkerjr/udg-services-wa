---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

export const prerender = true;

const title = "Pricing Guide | Upfront Appliance Repair Estimates | UDG Services";
const description = "Honest, transparent guide prices for appliance repairs across the Tri-Cities, WA. Upfront pricing before work begins and no hidden fees.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Appliance Repair Pricing | UDG Services",
  "image": "https://public.readdy.ai/ai/img_res/fca5f491f55ac01816dd784e81032f29.webp",
  "description": description,
  "url": `${SITE.url}/pricing/`,
};

const servicePricing = [
  {
    title: "Diagnostic visit",
    description: "A certified technician comes out, diagnoses the fault and gives you an upfront repair price before any work begins.",
    estimate: "Free estimate",
    icon: "search",
  },
  {
    title: "Refrigerator & freezer repair",
    description: "Cooling failures, leaks, ice makers and control boards — all major brands. Same-day for emergencies.",
    estimate: "Free estimate",
    icon: "fridge",
  },
  {
    title: "Washer repair",
    description: "Won't drain, won't spin, leaks or error codes. Front-load and top-load machines.",
    estimate: "Free estimate",
    icon: "washer",
  },
  {
    title: "Dryer repair",
    description: "No heat, long dry times or a drum that won't turn. Gas and electric dryers, vent check included.",
    estimate: "Free estimate",
    icon: "dryer",
  },
  {
    title: "Dishwasher repair",
    description: "Not cleaning, not draining or leaking. Built-in, portable and drawer-style models.",
    estimate: "Free estimate",
    icon: "dishwasher",
  },
  {
    title: "Oven & range repair",
    description: "Not heating, burners not lighting or temperature off. Gas and electric ovens and ranges.",
    estimate: "Free estimate",
    icon: "oven",
  },
  {
    title: "Commercial appliance repair",
    description: "Restaurants, hotels and retail. Priority scheduling and documentation available.",
    estimate: "Free estimate",
    icon: "store",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  headerVariant="solid"
  jsonLd={jsonLd}
>
  <div class="pt-20 pb-24 lg:pb-0" data-ps="src/pages/pricing.astro:9mxef1">
    <!-- Hero Banner Section -->
    <section class="px-3 md:px-4 pt-3 md:pt-4" data-ps="src/pages/pricing.astro:e0zfvi">
      <div class="relative w-full min-h-[380px] sm:min-h-[420px] md:min-h-[520px] rounded-2xl md:rounded-3xl overflow-hidden shadow-sm" data-ps="src/pages/pricing.astro:9mxef3">
        <img
          alt="Professional plumbing tools and equipment"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="absolute inset-0 w-full h-full object-cover object-top"
          src="https://pagesmith-cdn.com/9cf36851/images/1ce122f5f3387b910b71e4f748868547-ed3104-1536.webp" data-ps="src/pages/pricing.astro:74oa3h" />
        <!-- Dark Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#090a0d]/70 via-[#090a0d]/45 to-[#090a0d]/80 pointer-events-none" data-ps="src/pages/pricing.astro:9mxefp"></div>
        <div class="relative z-10 flex flex-col justify-end h-full min-h-[380px] sm:min-h-[420px] md:min-h-[520px] max-w-7xl mx-auto w-full px-6 sm:px-8 py-8 sm:py-10 md:py-14" data-ps="src/pages/pricing.astro:9mxefq">
          <div class="inline-flex self-start items-center gap-2 mb-4 sm:mb-5 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/25 text-white text-[10px] sm:text-xs uppercase tracking-[0.16em] font-medium" data-ps="src/pages/pricing.astro:9mxefr">
            <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/pages/pricing.astro:xa5v2g"></span>
            Transparent pricing
          </div>
          <h1 class="font-heading font-semibold text-white text-[32px] sm:text-[40px] md:text-[56px] lg:text-[72px] leading-[1.02] tracking-tight max-w-4xl" data-ps="src/pages/pricing.astro:xnxsy8">
            Free estimates,<br />
            <em class="not-italic text-[#EC5A00]">no surprises.</em>
          </h1>
          <p class="mt-3 sm:mt-4 md:mt-6 max-w-xl text-sm sm:text-base md:text-lg text-white/90 leading-relaxed font-normal" data-ps="src/pages/pricing.astro:8rrv0c">
            Honest guide prices for local appliance repair in the Tri-Cities. You'll always get a clear repair price before any work begins.
          </p>
          <div class="mt-5 sm:mt-6 md:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:gap-3" data-ps="src/pages/pricing.astro:9mxefs">
            <a
              class="group inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 rounded-full bg-[#EC5A00] text-white text-sm md:text-base font-semibold hover:bg-[#d45100] transition-all hover:-translate-y-0.5 no-underline shadow-sm whitespace-nowrap"
              href="/book"
             data-ps="src/pages/pricing.astro:fvprp5">
              Check Availability
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
            <a
              class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 rounded-full bg-white/10 border border-white/25 text-white text-sm md:text-base font-semibold hover:bg-white/20 transition-all no-underline whitespace-nowrap backdrop-blur-sm"
              href="/services"
             data-ps="src/pages/pricing.astro:fvprp6">
              View services
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Breakdown Section -->
    <section class="px-4 md:px-8 py-12 sm:py-16 md:py-24 bg-[#FBFAF7]" data-ps="src/pages/pricing.astro:e0zfvh">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-10 items-start" data-ps="src/pages/pricing.astro:9mxeft">
        <!-- Left Column: How pricing works -->
        <div class="lg:col-span-5" data-ps="src/pages/pricing.astro:9mxefu">
          <div class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-[#F5F3ED] border border-[#eae6de] text-[11px] uppercase tracking-[0.18em] text-[#5a5661]" data-ps="src/pages/pricing.astro:9mxefv">
            <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/pages/pricing.astro:xa5v2f"></span>
            How pricing works
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-5xl font-heading font-semibold tracking-tight text-[#020203] leading-[1.05]" data-ps="src/pages/pricing.astro:morbta">
            Straight-forward<br />
            <em class="not-italic text-[#EC5A00]">free estimates.</em>
          </h2>
          <p class="mt-4 text-[#5a5661] max-w-md" data-ps="src/pages/pricing.astro:8rrv0d">
            Final pricing depends on the job, location, access, parts and urgency. We'll always share a free estimate within 24 hours — no surprises.
          </p>
          <div class="mt-8 space-y-3" data-ps="src/pages/pricing.astro:9mxefw">
            <!-- Feature 1 -->
            <div class="flex items-start gap-3 p-4 rounded-xl bg-[#F5F3ED] border border-[#eae6de]" data-ps="src/pages/pricing.astro:9mxefx">
              <span class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#FBFAF7] text-[#EC5A00] shrink-0" data-ps="src/pages/pricing.astro:xa5v2e">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                  <line x1="7" y1="7" x2="7.01" y2="7"></line>
                </svg>
              </span>
              <div data-ps="src/pages/pricing.astro:9mxefy">
                <p class="text-sm font-semibold text-[#020203]" data-ps="src/pages/pricing.astro:8rrv0e">Free estimate first</p>
                <p class="text-xs text-[#5a5661]" data-ps="src/pages/pricing.astro:8rrv0f">You'll see the likely cost within 24 hours before work begins.</p>
              </div>
            </div>

            <!-- Feature 2 -->
            <div class="flex items-start gap-3 p-4 rounded-xl bg-[#F5F3ED] border border-[#eae6de]" data-ps="src/pages/pricing.astro:9mxegk">
              <span class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#FBFAF7] text-[#EC5A00] shrink-0" data-ps="src/pages/pricing.astro:xa5v1s">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </span>
              <div data-ps="src/pages/pricing.astro:9mxegl">
                <p class="text-sm font-semibold text-[#020203]" data-ps="src/pages/pricing.astro:8rrv11">Local visits</p>
                <p class="text-xs text-[#5a5661]" data-ps="src/pages/pricing.astro:8rrv12">No inflated travel charges for local Tri-Cities and Washington jobs.</p>
              </div>
            </div>

            <!-- Feature 3 -->
            <div class="flex items-start gap-3 p-4 rounded-xl bg-[#F5F3ED] border border-[#eae6de]" data-ps="src/pages/pricing.astro:9mxegm">
              <span class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#FBFAF7] text-[#EC5A00] shrink-0" data-ps="src/pages/pricing.astro:xa5v1r">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                </svg>
              </span>
              <div data-ps="src/pages/pricing.astro:9mxegn">
                <p class="text-sm font-semibold text-[#020203]" data-ps="src/pages/pricing.astro:8rrv13">Parts at cost</p>
                <p class="text-xs text-[#5a5661]" data-ps="src/pages/pricing.astro:8rrv14">Standard parts included where reasonable; larger parts quoted upfront.</p>
              </div>
            </div>

            <!-- Feature 4 -->
            <div class="flex items-start gap-3 p-4 rounded-xl bg-[#F5F3ED] border border-[#eae6de]" data-ps="src/pages/pricing.astro:9mxego">
              <span class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#FBFAF7] text-[#EC5A00] shrink-0" data-ps="src/pages/pricing.astro:xa5v1q">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              </span>
              <div data-ps="src/pages/pricing.astro:9mxegp">
                <p class="text-sm font-semibold text-[#020203]" data-ps="src/pages/pricing.astro:8rrv15">Warranty included</p>
                <p class="text-xs text-[#5a5661]" data-ps="src/pages/pricing.astro:8rrv16">All repairs and replacement parts come with a warranty for peace of mind.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Services Estimate Table -->
        <div class="lg:col-span-7" data-ps="src/pages/pricing.astro:9mxegq">
          <div class="rounded-2xl bg-[#F5F3ED] border border-[#eae6de] overflow-hidden" data-ps="src/pages/pricing.astro:9mxegr">
            <div class="hidden sm:flex px-5 md:px-7 py-4 text-[11px] uppercase tracking-[0.16em] text-[#71717a] border-b border-[#eae6de]" data-ps="src/pages/pricing.astro:9mxegs">
              <div class="flex-1" data-ps="src/pages/pricing.astro:9mxegt">Service</div>
              <div class="w-32 text-right" data-ps="src/pages/pricing.astro:e246nf">Estimate</div>
            </div>

            {servicePricing.map((item, __psIdx) => (
              <div class="flex items-center gap-3 px-4 sm:px-5 md:px-7 py-4 sm:py-5 border-b border-[#eae6de] last:border-b-0 hover:bg-[#FBFAF7] transition-colors" data-ps={`src/pages/pricing.astro:e246ng-${__psIdx}`}>
                <span class="w-10 h-10 flex items-center justify-center rounded-full bg-[#FBFAF7] text-[#EC5A00] shrink-0" data-ps={`src/pages/pricing.astro:xa5v1p-${__psIdx}`}>
                  {item.icon === 'search' && (
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                  )}
                  {item.icon === 'fridge' && (
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                      <line x1="4" y1="10" x2="20" y2="10"></line>
                      <line x1="9" y1="6" x2="9" y2="7"></line>
                      <line x1="9" y1="14" x2="9" y2="16"></line>
                    </svg>
                  )}
                  {item.icon === 'washer' && (
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                      <circle cx="12" cy="13" r="4"></circle>
                      <line x1="7" y1="6" x2="7.01" y2="6"></line>
                      <line x1="11" y1="6" x2="13" y2="6"></line>
                    </svg>
                  )}
                  {item.icon === 'dryer' && (
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"></path>
                    </svg>
                  )}
                  {item.icon === 'dishwasher' && (
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                      <line x1="3" y1="9" x2="21" y2="9"></line>
                      <path d="M8 14h.01M12 14h.01M16 14h.01"></path>
                    </svg>
                  )}
                  {item.icon === 'oven' && (
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                    </svg>
                  )}
                  {item.icon === 'store' && (
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                      <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                  )}
                </span>
                <div class="min-w-0 flex-1" data-ps={`src/pages/pricing.astro:e246nh-${__psIdx}`}>
                  <p class="text-sm md:text-base font-semibold text-[#020203] truncate" data-ps={`src/pages/pricing.astro:8rrv17-${__psIdx}`}>{item.title}</p>
                  <p class="text-xs md:text-sm text-[#5a5661] line-clamp-2" data-ps={`src/pages/pricing.astro:8rrv18-${__psIdx}`}>{item.description}</p>
                </div>
                <div class="shrink-0 text-right" data-ps={`src/pages/pricing.astro:e246ni-${__psIdx}`}>
                  <span class="text-xs sm:text-sm font-semibold text-[#EC5A00] whitespace-nowrap" data-ps={`src/pages/pricing.astro:xa5v1o-${__psIdx}`}>{item.estimate}</span>
                </div>
              </div>
            ))}
          </div>

          <!-- Info Banner Below Table -->
          <div class="mt-5 flex flex-col sm:flex-row items-start sm:items-center gap-3 p-4 sm:p-5 rounded-xl bg-[#090a0d] text-white" data-ps="src/pages/pricing.astro:e246nj">
            <svg class="w-6 h-6 text-[#EC5A00] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <p class="text-sm text-[#e4e4e7] leading-relaxed" data-ps="src/pages/pricing.astro:8rrv19">
              All pricing is estimate-based. Free estimates within 24 hours — you'll always know the cost before the job goes ahead.
            </p>
            <a
              class="sm:ml-auto shrink-0 group inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-[#EC5A00] text-white text-sm font-semibold hover:bg-[#d45100] transition-colors cursor-pointer whitespace-nowrap no-underline shadow-sm"
              href="/book"
             data-ps="src/pages/pricing.astro:fvprp7">
              Check Availability
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom Book Online CTA Section -->
    <section class="px-4 md:px-8 py-12 sm:py-16 md:py-24 bg-[#FBFAF7]" data-ps="src/pages/pricing.astro:e0zfvg">
      <div class="max-w-5xl mx-auto text-center flex flex-col items-center" data-ps="src/pages/pricing.astro:e246nk">
        <div class="inline-flex items-center gap-2 mb-5 px-3 py-1 rounded-full bg-[#F5F3ED] border border-[#eae6de] text-[11px] uppercase tracking-[0.18em] text-[#5a5661]" data-ps="src/pages/pricing.astro:e246nl">
          <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/pages/pricing.astro:xa5v1n"></span>
          Book online
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-6xl font-heading font-semibold tracking-tight text-[#020203] leading-[1.05] max-w-3xl" data-ps="src/pages/pricing.astro:morbtb">
          Get a clear quote,<br />
          <em class="not-italic text-[#EC5A00]">without the hassle.</em>
        </h2>
        <p class="mt-4 sm:mt-5 text-sm sm:text-base md:text-lg text-[#5a5661] max-w-xl" data-ps="src/pages/pricing.astro:8rrv1a">
          A short booking form and a couple of photos are all we need to price up your job.
        </p>
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto" data-ps="src/pages/pricing.astro:e246nm">
          <a
            class="group inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 rounded-full bg-[#090a0d] text-white text-sm font-semibold hover:bg-black transition-all hover:-translate-y-0.5 cursor-pointer whitespace-nowrap no-underline shadow-sm"
            href="/book"
           data-ps="src/pages/pricing.astro:fvprp8">
            Book Service
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
          <a
            class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 rounded-full bg-transparent text-[#020203] text-sm font-semibold hover:text-[#EC5A00] transition-colors cursor-pointer whitespace-nowrap no-underline"
            href="/contact"
           data-ps="src/pages/pricing.astro:fvprp9">
            Send a message
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Mobile Floating Action Bar -->
    <div class="lg:hidden fixed bottom-3 left-3 right-3 z-40" data-ps="src/pages/pricing.astro:e246nn">
      <div class="flex items-center gap-2 p-2 rounded-2xl bg-[#090a0d]/95 backdrop-blur-md border border-[#27272a] shadow-lg" data-ps="src/pages/pricing.astro:e246no">
        <a
          href="tel:+15093004042"
          aria-label="Call UDG Services"
          class="w-12 h-12 flex items-center justify-center rounded-xl bg-white/10 text-white hover:bg-white/15 transition-colors cursor-pointer no-underline"
         data-ps="src/pages/pricing.astro:fvprpa">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
          </svg>
