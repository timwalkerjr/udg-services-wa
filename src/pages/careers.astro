---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Careers at UDG Services',
  description: 'Join the UDG Services appliance repair crew in Tri-Cities, WA. We are hiring Appliance Repair Technicians, Refrigeration Technicians, Service Dispatchers, and Apprentice Technicians.',
  url: `${SITE.url}/careers/`,
};

const jobOpenings = [
  {
    title: 'Appliance Repair Technician',
    badge: 'Hiring now',
    location: 'Full-time · Tri-Cities, WA',
    description: "Diagnose and repair refrigerators, washers, dryers, dishwashers and ranges in customers' homes. Experience with major brands preferred — we'll train the right person.",
    icon: 'wrench',
  },
  {
    title: 'Refrigeration Technician',
    badge: 'Hiring now',
    location: 'Full-time · Richland, WA',
    description: 'Service residential fridges, freezers and commercial refrigeration. EPA certification and strong diagnostic skills a plus.',
    icon: 'fridge',
  },
  {
    title: 'Service Dispatcher / Customer Care',
    badge: 'Hiring now',
    location: 'Full-time · Tri-Cities, WA',
    description: 'Be the friendly voice customers reach first. Schedule visits, keep technicians on route and follow up on every job. Organized, calm and customer-focused.',
    icon: 'headset',
  },
  {
    title: 'Apprentice Technician',
    badge: 'Hiring now',
    location: 'Full-time · Tri-Cities, WA',
    description: 'Learn appliance repair from experienced techs. Assist with installs, diagnostics and service calls. No experience required — just a strong work ethic.',
    icon: 'academic',
  },
];

const benefits = [
  {
    text: 'Competitive pay with overtime opportunities',
    icon: 'money',
  },
  {
    text: 'Health insurance & retirement plan',
    icon: 'health',
  },
  {
    text: 'Paid time off & paid holidays',
    icon: 'calendar',
  },
  {
    text: 'Company van, tools & equipment provided',
    icon: 'van',
  },
  {
    text: 'Ongoing training & certification support',
    icon: 'training',
  },
  {
    text: "Veteran-owned — you're a teammate, not a number",
    icon: 'veteran',
  },
];
---

<BaseLayout
  title={SITE.title}
  description="Join the UDG Services appliance repair crew in Tri-Cities, WA. We are hiring Appliance Repair Technicians, Refrigeration Technicians, Service Dispatchers, and Apprentice Technicians."
  headerVariant="solid"
  jsonLd={jsonLd}
>
  <div class="pt-20 md:pt-24 pb-20 lg:pb-0" data-ps="src/pages/careers.astro:cr-root">
    <!-- Hero Banner Section -->
    <section class="px-3 md:px-4 pt-3 md:pt-4" data-ps="src/pages/careers.astro:cr-hero-sec">
      <div class="relative w-full min-h-[380px] sm:min-h-[420px] md:min-h-[520px] rounded-2xl md:rounded-3xl overflow-hidden shadow-sm" data-ps="src/pages/careers.astro:cr-hero-wrap">
        <img
          src="https://pagesmith-cdn.com/9cf36851/images/edited_729d65fc14d2984952030944adea0fe5_cc2a6e75-d8cede-1024.webp"
          alt="UDG Services appliance repair vans and open garage in a suburban Washington setting"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="absolute inset-0 w-full h-full object-cover object-top"
          data-ps="src/pages/careers.astro:cr-hero-img"
        />
        <!-- Dark Atmospheric Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#090a0d]/70 via-[#090a0d]/45 to-[#090a0d]/80 pointer-events-none" data-ps="src/pages/careers.astro:cr-hero-overlay"></div>

        <!-- Banner Content -->
        <div class="relative z-10 flex flex-col justify-end h-full min-h-[380px] sm:min-h-[420px] md:min-h-[520px] max-w-7xl mx-auto w-full px-6 sm:px-8 py-8 sm:py-12 md:py-16" data-ps="src/pages/careers.astro:cr-hero-content">
          <div class="inline-flex self-start items-center gap-2 mb-4 sm:mb-5 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/25 text-white text-[10px] sm:text-xs uppercase tracking-[0.16em] font-medium" data-ps="src/pages/careers.astro:cr-hero-badge">
            <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/pages/careers.astro:cr-hero-dot"></span>
            Careers
          </div>
          <h1 class="font-heading font-semibold text-white text-[32px] sm:text-[44px] md:text-[60px] lg:text-[72px] leading-[1.02] tracking-tight max-w-4xl" data-ps="src/pages/careers.astro:cr-hero-h1">
            Build a career<br />
            <em class="not-italic text-[#EC5A00]">with the best.</em>
          </h1>
          <p class="mt-3 sm:mt-4 md:mt-6 max-w-xl text-sm sm:text-base md:text-lg text-[#FBFAF7]/90 leading-relaxed font-normal" data-ps="src/pages/careers.astro:cr-hero-p">
            UDG Services is a veteran-owned, family-run appliance repair company that values hard work, integrity, and the people who show up every day. Join a team that treats you like family across the Tri-Cities.
          </p>
          <div class="mt-5 sm:mt-6 md:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3" data-ps="src/pages/careers.astro:cr-hero-actions">
            <a
              href="#openings"
              class="group inline-flex items-center justify-center gap-2 px-6 py-3.5 sm:py-4 rounded-full bg-[#EC5A00] text-white text-sm md:text-base font-semibold hover:bg-[#d45100] transition-all hover:-translate-y-0.5 no-underline shadow-md"
              data-ps="src/pages/careers.astro:cr-hero-cta1"
            >
              Apply now
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
            <a
              href="/team"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 sm:py-4 rounded-full bg-white/10 border border-white/25 text-white text-sm md:text-base font-semibold hover:bg-white/20 transition-all no-underline backdrop-blur-sm"
              data-ps="src/pages/careers.astro:cr-hero-cta2"
            >
              Meet the team
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Job Openings & Why Work Here Section -->
    <section id="openings" class="px-4 sm:px-6 md:px-8 py-12 sm:py-16 md:py-24 bg-[#FBFAF7]" data-ps="src/pages/careers.astro:cr-openings-sec">
      <div class="max-w-7xl mx-auto" data-ps="src/pages/careers.astro:cr-openings-wrap">
        <!-- Section Header -->
        <div class="text-center mb-10 md:mb-14" data-ps="src/pages/careers.astro:cr-openings-header">
          <div class="inline-flex items-center gap-2 mb-4 px-3.5 py-1 rounded-full bg-[#F5F3ED] border border-[#eae6de] text-[11px] uppercase tracking-[0.18em] text-[#5a5661] font-medium" data-ps="src/pages/careers.astro:cr-openings-badge">
            <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/pages/careers.astro:cr-openings-dot"></span>
            Careers
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-5xl font-heading font-semibold tracking-tight text-[#020203] leading-[1.05]" data-ps="src/pages/careers.astro:cr-openings-h2">
            Join the <em class="not-italic text-[#EC5A00]">UDG Services crew.</em>
          </h2>
          <p class="mt-4 text-sm md:text-base text-[#5a5661] max-w-xl mx-auto leading-relaxed" data-ps="src/pages/careers.astro:cr-openings-p">
            We're growing across the Tri-Cities and looking for skilled, reliable people who take pride in honest work. If that sounds like you, let's talk.
          </p>
        </div>

        <!-- 2-Column Grid: Open Positions & Benefits Sidebar -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-10 items-start" data-ps="src/pages/careers.astro:cr-openings-grid">
          <!-- Left: 4 Job Listing Cards -->
          <div class="lg:col-span-7 space-y-4" data-ps="src/pages/careers.astro:cr-jobs-list">
            {jobOpenings.map((job, idx) => (
              <div
                class="p-5 md:p-6 rounded-2xl bg-[#F5F3ED] border border-[#eae6de] hover:border-[#EC5A00]/40 transition-colors shadow-2xs"
                data-ps={`src/pages/careers.astro:cr-job-card-${idx}`}
              >
                <div class="flex items-start gap-4" data-ps={`src/pages/careers.astro:ifxkz-${idx}`}>
                  <!-- Job Icon -->
                  <span class="w-11 h-11 flex items-center justify-center rounded-xl bg-[#EC5A00]/10 text-[#EC5A00] shrink-0" data-ps={`src/pages/careers.astro:cr-job-icon-${idx}`}>
                    {job.icon === 'wrench' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                      </svg>
                    )}
                    {job.icon === 'fridge' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                        <line x1="4" y1="10" x2="20" y2="10"></line>
                        <line x1="9" y1="6" x2="9" y2="7"></line>
                        <line x1="9" y1="14" x2="9" y2="16"></line>
                      </svg>
                    )}
                    {job.icon === 'headset' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                        <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                      </svg>
                    )}
                    {job.icon === 'academic' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                      </svg>
                    )}
                  </span>

                  <!-- Job Details -->
                  <div class="flex-1 min-w-0" data-ps={`src/pages/careers.astro:ifxl0-${idx}`}>
                    <div class="flex flex-wrap items-center gap-2 mb-1" data-ps={`src/pages/careers.astro:ifxl1-${idx}`}>
                      <h3 class="text-base md:text-lg font-heading font-semibold text-[#020203]" data-ps={`src/pages/careers.astro:cr-job-title-${idx}`}>
                        {job.title}
                      </h3>
                      <span class="px-2.5 py-0.5 rounded-full bg-[#EC5A00]/10 text-[#EC5A00] text-[11px] font-semibold uppercase tracking-wide" data-ps={`src/pages/careers.astro:cr-job-badge-${idx}`}>
                        {job.badge}
                      </span>
                    </div>
                    <p class="text-xs text-[#5a5661] font-medium" data-ps={`src/pages/careers.astro:cr-job-loc-${idx}`}>{job.location}</p>
                    <p class="mt-2 text-sm text-[#5a5661] leading-relaxed" data-ps={`src/pages/careers.astro:cr-job-desc-${idx}`}>
                      {job.description}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Right: Why Work Here Sticky Card -->
          <div class="lg:col-span-5" data-ps="src/pages/careers.astro:cr-benefits-col">
            <div class="sticky top-24 p-6 md:p-8 rounded-2xl bg-[#090a0d] text-[#FBFAF7] shadow-xl border border-white/5" data-ps="src/pages/careers.astro:cr-benefits-card">
              <h3 class="text-lg md:text-xl font-heading font-semibold text-white mb-6" data-ps="src/pages/careers.astro:cr-benefits-h3">
                Why work here?
              </h3>
              <ul class="space-y-4 list-none p-0 m-0" data-ps="src/pages/careers.astro:cr-benefits-list">
                {benefits.map((item, idx) => (
                  <li class="flex items-start gap-3" data-ps={`src/pages/careers.astro:cr-benefit-item-${idx}`}>
                    <span class="text-[#EC5A00] shrink-0 mt-0.5" data-ps={`src/pages/careers.astro:cr-benefit-icon-${idx}`}>
                      {item.icon === 'money' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path>
                          <path d="M12 18V6"></path>
                        </svg>
                      )}
                      {item.icon === 'health' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                        </svg>
                      )}
                      {item.icon === 'calendar' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                          <line x1="16" y1="2" x2="16" y2="6"></line>
                          <line x1="8" y1="2" x2="8" y2="6"></line>
                          <line x1="3" y1="10" x2="21" y2="10"></line>
                          <path d="m9 16 2 2 4-4"></path>
                        </svg>
                      )}
                      {item.icon === 'van' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="1" y="3" width="15" height="13"></rect>
                          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                          <circle cx="5.5" cy="18.5" r="2.5"></circle>
                          <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                      )}
                      {item.icon === 'training' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                          <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                        </svg>
                      )}
                      {item.icon === 'veteran' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                          <polygon points="12 8 13.5 11 17 11.5 14.5 14 15 17.5 12 16 9 17.5 9.5 14 7 11.5 10.5 11"></polygon>
                        </svg>
                      )}
                    </span>
                    <span class="text-sm text-[#d4d4d8] leading-relaxed" data-ps={`src/pages/careers.astro:cr-benefit-text-${idx}`}>{item.text}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-8 pt-6 border-t border-white/10" data-ps="src/pages/careers.astro:cr-benefits-cta-wrap">
                <a
                  href="mailto:careers@udgservices.com?subject=Career%20Inquiry%20-%20UDG%20Services"
                  class="group w-full flex items-center justify-center gap-2 px-5 py-3.5 rounded-full bg-[#EC5A00] text-white text-sm font-semibold hover:bg-[#d45100] transition-all no-underline shadow-sm hover:-translate-y-0.5"
                  data-ps="src/pages/careers.astro:cr-benefits-btn"
                >
                  Apply now
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </a>
                <p class="mt-3.5 text-center text-xs text-[#a1a1aa]" data-ps="src/pages/careers.astro:cr-benefits-phone">
                  Or call us at{' '}
                  <a href="tel:+15093004042" class="text-[#EC5A00] hover:underline font-semibold no-underline" data-ps="src/pages/careers.astro:cr-benefits-phonelink">
                    (509) 300-4042
                  </a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Questions / Not sure which role fits you best? Section -->
    <section class="px-4 sm:px-6 md:px-8 py-16 sm:py-20 md:py-28 bg-[#FBFAF7] border-t border-[#eae6de]" data-ps="src/pages/careers.astro:cr-questions-sec">
      <div class="max-w-5xl mx-auto text-center flex flex-col items-center" data-ps="src/pages/careers.astro:cr-questions-wrap">
        <div class="inline-flex items-center gap-2 mb-5 px-3.5 py-1 rounded-full bg-[#F5F3ED] border border-[#eae6de] text-[11px] uppercase tracking-[0.18em] text-[#5a5661] font-medium" data-ps="src/pages/careers.astro:cr-questions-badge">
          <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/pages/careers.astro:cr-questions-dot"></span>
          Questions?
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-6xl font-heading font-semibold tracking-tight text-[#020203] leading-[1.05] max-w-3xl" data-ps="src/pages/careers.astro:cr-questions-h2">
          Not sure which role<br />
          <em class="not-italic text-[#EC5A00]">fits you best?</em>
        </h2>
        <p class="mt-4 sm:mt-5 text-sm sm:text-base md:text-lg text-[#5a5661] max-w-xl leading-relaxed" data-ps="src/pages/careers.astro:cr-questions-p">
          Send us a message or give us a call. We're happy to talk through the opportunities and find the right fit.
        </p>
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto justify-center" data-ps="src/pages/careers.astro:cr-questions-actions">
          <a
            href="/contact"
            class="group inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3.5 sm:py-4 rounded-full bg-[#090a0d] text-white text-sm font-semibold hover:bg-black transition-all hover:-translate-y-0.5 no-underline shadow-sm"
            data-ps="src/pages/careers.astro:cr-questions-btn1"
          >
            Contact us
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3.5 sm:py-4 rounded-full bg-transparent text-[#020203] text-sm font-semibold hover:text-[#EC5A00] transition-colors no-underline"
            data-ps="src/pages/careers.astro:cr-questions-btn2"
          >
            Send a message
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Mobile Floating Action Bar -->
    <div class="lg:hidden fixed bottom-3 left-3 right-3 z-40" data-ps="src/pages/careers.astro:cr-mobile-bar">
      <div class="flex items-center gap-2 p-2 rounded-2xl bg-[#090a0d]/95 backdrop-blur-md border border-white/10 shadow-xl" data-ps="src/pages/careers.astro:cr-mobile-bar-inner">
        <a
          href="tel:+15093004042"
          aria-label="Call UDG Services"
          class="w-12 h-12 flex items-center justify-center rounded-xl bg-white/10 text-white hover:bg-white/15 transition-colors shrink-0 no-underline"
          data-ps="src/pages/careers.astro:cr-mobile-call"
        >
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
          </svg>
        </a>
        <a
          href="/book"
          class="flex-1 h-12 flex items-center justify-center gap-2 rounded-xl bg-[#EC5A00] text-white text-sm font-semibold hover:bg-[#d45100] transition-colors no-underline shadow-sm"
          data-ps="src/pages/careers.astro:cr-mobile-book"
        >
          Book a Repair Now
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
