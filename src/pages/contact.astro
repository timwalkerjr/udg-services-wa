          </form>
        </div>
      </div>
    </section>

    <!-- Mobile Floating Action Bar -->
    <div class="lg:hidden fixed bottom-3 left-3 right-3 z-40" data-ps="src/pages/contact.astro:lx8n1j">
      <div class="flex items-center gap-2 p-2 rounded-2xl bg-[#090a0d]/95 backdrop-blur-md border border-white/10 shadow-xl" data-ps="src/pages/contact.astro:lx8n1i">
        <a
          href="tel:+15093004042"
          aria-label="Call UDG Services"
          class="w-12 h-12 flex items-center justify-center rounded-xl bg-white/10 text-white hover:bg-white/15 transition-colors shrink-0 no-underline"
         data-ps="src/pages/contact.astro:5elr9j">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
          </svg>
        </a>
        <a
          href="/book"
          class="flex-1 h-12 flex items-center justify-center gap-2 rounded-xl bg-[#EC5A00] text-white text-sm font-semibold hover:bg-[#d45100] transition-colors no-underline shadow-sm"
         data-ps="src/pages/contact.astro:5elr9i">
          Book a Repair Now
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
