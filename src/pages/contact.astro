  </div>

  <script>
    import 'altcha';

    const form = document.getElementById('contact-form-element') as HTMLFormElement;
    const formStatus = document.getElementById('contact-status') as HTMLDivElement;
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
    const submitBtnText = document.getElementById('contact-submit-text');
    const messageInput = document.getElementById('message-input') as HTMLTextAreaElement;
    const charCounter = document.getElementById('char-counter');

    messageInput?.addEventListener('input', () => {
      if (charCounter) {
        charCounter.textContent = `${messageInput.value.length} / 500 characters`;
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (submitBtn) submitBtn.disabled = true;
      if (submitBtnText) submitBtnText.textContent = 'Sending message...';

      const formData = new FormData(form);

      const payload = {
        _formId: formData.get('_formId') || 'contact',
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        city: formData.get('city'),
        preferred_contact: formData.get('preferred_contact'),
        message: formData.get('message'),
        altcha: formData.get('altcha'),
      };

      try {
        const response = await fetch('/psapi-internal-v1/forms/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (result.success) {
          formStatus.className = 'px-4 py-3 rounded-xl text-sm font-medium bg-emerald-50 border border-emerald-200 text-emerald-800';
          formStatus.innerHTML = `<strong>Message sent!</strong> Thank you ${payload.name || ''}, we have received your message and will get back to you shortly.`;
          form.reset();
          if (charCounter) charCounter.textContent = 'Up to 500 characters';
        } else {
          throw new Error(result.error || 'Failed to send message. Please try again.');
        }
      } catch (err: any) {
        formStatus.className = 'px-4 py-3 rounded-xl text-sm font-medium bg-red-50 border border-red-200 text-red-800';
        formStatus.textContent = err?.message || 'There was an issue sending your message. Please give us a call at (509) 300-4042.';
      } finally {
        formStatus.classList.remove('hidden');
        if (submitBtn) submitBtn.disabled = false;
        if (submitBtnText) submitBtnText.textContent = 'Send Message';
        formStatus.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  </script>
</BaseLayout>
