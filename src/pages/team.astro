---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Our Team & Fleet | UDG Services',
  description: "Real vans. Real jobs. Real results. UDG Services is a veteran-owned, family-run appliance repair team trusted across the Tri-Cities and Washington's Columbia Basin.",
  url: `${SITE.url}/team/`,
};

const galleryImages = [
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_0ecdb9b10fed21b734c6418c01adf37c_aabcefed-a87446-1024.webp',
    alt: 'UDG Services appliance repair van parked in front of a suburban Washington home',
    category: 'fleet',
  },
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_ef4725fdbd0b7442b2c254b377634693_7f0c8625-b22d03-1024.webp',
    alt: 'Two UDG Services appliance repair vans parked side by side with an open garage in a Washington neighbourhood',
    category: 'fleet',
  },
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_729d65fc14d2984952030944adea0fe5_cc2a6e75-d8cede-1024.webp',
    alt: 'UDG Services service vans and open garage in a suburban Washington setting',
    category: 'fleet',
  },
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_bfac6f062abfff94440bf01b90863d42_528639fe-ed38ce-768.webp',
    alt: 'UDG Services appliance repair van parked in a tree-lined Washington neighbourhood',
    category: 'fleet',
  },
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_22433d633075574f85873ceb52ec10c2_64102400-6a114a-768.webp',
    alt: 'UDG Services appliance repair van in a suburban Tri-Cities Washington neighbourhood',
    category: 'fleet',
  },
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_bba61f648c62e2a08b391e2eea5c0530_09d496cc-f9afa9-1024.webp',
    alt: 'UDG Services service van parked on a tree-lined suburban street in the Tri-Cities Washington',
    category: 'fleet',
  },
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_f6b3bd27f23e0f98faf0cc5c9884dd46_a74b9826-a162e8-1024.webp',
    alt: 'Modern kitchen full of stainless steel appliances with tools organized on the counter after a service call',
    category: 'job',
  },
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_3d4cb750ae4dca616602d99717199f52_fb196666-7c03bd-1024.webp',
    alt: 'Residential refrigerator with the back open and a new compressor, tools and parts laid out on a clean floor',
    category: 'job',
  },
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_d52c0cb057202bd3cdccce92215f54bc_d2b89a67-66aea3-1024.webp',
    alt: 'Front-load washing machine with the drum and belt exposed during a repair in a bright laundry room',
    category: 'job',
  },
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_d2988ec50fa3bd105db9a324ee9d3749_626318d0-3814e8-1024.webp',
    alt: 'Electric oven range with the heating element exposed and a multimeter nearby during testing',
    category: 'job',
  },
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_dbdf42e469a172eea0db251dc3b5b277_0d5bdec2-9602c0-1024.webp',
    alt: 'Open dishwasher with spray arm and drain pump visible during a repair in a clean kitchen',
    category: 'job',
  },
  {
    src: 'https://pagesmith-cdn.com/9cf36851/images/edited_99e0d24be5b06ad446eeb114205e78f7_fa5f7ff4-983f99-1024.webp',
    alt: 'Clothes dryer with the vent and lint trap exposed during servicing in a utility room',
    category: 'job',
  },
];

const jobOpenings = [
  {
    title: 'Appliance Repair Technician',
    badge: 'Hiring now',
    location: 'Full-time · Tri-Cities, WA',
    description: "Diagnose and repair refrigerators, washers, dryers, dishwashers and ranges in customers' homes. Experience with major brands preferred — we'll train the right person.",
    icon: 'wrench',
  },
  {
    title: 'Refrigeration Technician',
    badge: 'Hiring now',
    location: 'Full-time · Richland, WA',
    description: 'Service residential fridges, freezers and commercial refrigeration. EPA certification and strong diagnostic skills a plus.',
    icon: 'fridge',
  },
  {
    title: 'Service Dispatcher / Customer Care',
    badge: 'Hiring now',
    location: 'Full-time · Tri-Cities, WA',
    description: 'Be the friendly voice customers reach first. Schedule visits, keep technicians on route and follow up on every job. Organized, calm and customer-focused.',
    icon: 'headset',
  },
  {
    title: 'Apprentice Technician',
    badge: 'Hiring now',
    location: 'Full-time · Tri-Cities, WA',
    description: 'Learn appliance repair from experienced techs. Assist with installs, diagnostics and service calls. No experience required — just a strong work ethic.',
    icon: 'academic',
  },
];

const benefits = [
  {
    text: 'Competitive pay with overtime opportunities',
    icon: 'money',
  },
  {
    text: 'Health insurance & retirement plan',
    icon: 'health',
  },
  {
    text: 'Paid time off & paid holidays',
    icon: 'calendar',
  },
  {
    text: 'Company van, tools & equipment provided',
    icon: 'van',
  },
  {
    text: 'Ongoing training & certification support',
    icon: 'training',
  },
  {
    text: "Veteran-owned — you're a teammate, not a number",
    icon: 'veteran',
  },
];
---

<BaseLayout
  title="Our Team & Fleet | Veteran-Owned Appliance Repair | UDG Services"
  description="Real vans. Real jobs. Real results. UDG Services is a veteran-owned, family-run appliance repair team trusted across the Tri-Cities and Washington's Columbia Basin."
  headerVariant="solid"
  jsonLd={jsonLd}
>
  <div class="pt-20 md:pt-20 pb-24 lg:pb-0" data-ps="src/pages/team.astro:tm-root">
    <!-- Hero Banner Section -->
    <section class="px-3 md:px-4 pt-3 md:pt-4" data-ps="src/pages/team.astro:tm-hero-sec">
      <div class="relative w-full min-h-[380px] sm:min-h-[420px] md:min-h-[520px] rounded-2xl md:rounded-3xl overflow-hidden shadow-sm" data-ps="src/pages/team.astro:tm-hero-wrap">
        <img
          alt="Two UDG Services appliance repair vans parked side by side in a suburban Washington neighbourhood"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="absolute inset-0 w-full h-full object-cover object-top"
          src="https://pagesmith-cdn.com/9cf36851/images/edited_ef4725fdbd0b7442b2c254b377634693_7f0c8625-b22d03-1024.webp"
          data-ps="src/pages/team.astro:tm-hero-img"
        />
        <!-- Dark Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-b from-[#090a0d]/70 via-[#090a0d]/45 to-[#090a0d]/80 pointer-events-none" data-ps="src/pages/team.astro:tm-hero-overlay"></div>

        <!-- Hero Content Overlay -->
        <div class="relative z-10 flex flex-col justify-end h-full min-h-[380px] sm:min-h-[420px] md:min-h-[520px] max-w-7xl mx-auto w-full px-6 sm:px-8 py-8 sm:py-10 md:py-14" data-ps="src/pages/team.astro:tm-hero-content">
          <div class="inline-flex self-start items-center gap-2 mb-4 sm:mb-5 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/25 text-white text-[10px] sm:text-xs uppercase tracking-[0.16em] font-medium" data-ps="src/pages/team.astro:tm-hero-badge">
            <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/pages/team.astro:tm-hero-dot"></span>
            Our Team
          </div>
          <h1 class="font-heading font-semibold text-white text-[32px] sm:text-[40px] md:text-[56px] lg:text-[72px] leading-[1.02] tracking-tight max-w-4xl" data-ps="src/pages/team.astro:tm-hero-h1">
            The company<br />
            <em class="not-italic text-[#EC5A00]">behind the work.</em>
          </h1>
          <p class="mt-3 sm:mt-4 md:mt-6 max-w-xl text-sm sm:text-base md:text-lg text-white/90 leading-relaxed font-normal" data-ps="src/pages/team.astro:tm-hero-p">
            Real vans. Real jobs. Real results. UDG Services is a veteran-owned, family-run appliance repair team trusted across the Tri-Cities and Washington's Columbia Basin.
          </p>
          <div class="mt-5 sm:mt-6 md:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:gap-3" data-ps="src/pages/team.astro:tm-hero-actions">
            <a
              class="group inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 rounded-full bg-[#EC5A00] text-white text-sm md:text-base font-semibold hover:bg-[#d45100] transition-all hover:-translate-y-0.5 no-underline shadow-sm whitespace-nowrap"
              href="/book"
              data-ps="src/pages/team.astro:tm-hero-cta1"
            >
              Book Service
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
            <a
              class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 rounded-full bg-white/10 border border-white/25 text-white text-sm md:text-base font-semibold hover:bg-white/20 transition-all no-underline whitespace-nowrap backdrop-blur-sm"
              href="/services"
              data-ps="src/pages/team.astro:tm-hero-cta2"
            >
              See services
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3-Column Highlights Section -->
    <section class="px-4 md:px-8 py-12 sm:py-16 md:py-20 bg-[#FBFAF7]" data-ps="src/pages/team.astro:tm-highlights-sec">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8" data-ps="src/pages/team.astro:tm-highlights-grid">
        <!-- Card 1 -->
        <div class="p-6 md:p-8 rounded-2xl bg-[#F5F3ED] border border-[#eae6de]" data-ps="src/pages/team.astro:tm-card-1">
          <span class="w-12 h-12 flex items-center justify-center rounded-xl bg-[#EC5A00]/10 text-[#EC5A00]" data-ps="src/pages/team.astro:tm-card-icon-1">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 12 15 16 10"></polyline>
            </svg>
          </span>
          <h3 class="mt-5 text-lg md:text-xl font-heading font-semibold text-[#020203]" data-ps="src/pages/team.astro:tm-card-title-1">Licensed &amp; Insured</h3>
          <p class="mt-2 text-sm text-[#5a5661] leading-relaxed" data-ps="src/pages/team.astro:tm-card-desc-1">
            Every job is handled by a licensed, insured technician with ongoing training on the latest appliances and safety protocols. WA License #UDGSES*15704.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="p-6 md:p-8 rounded-2xl bg-[#F5F3ED] border border-[#eae6de]" data-ps="src/pages/team.astro:tm-card-2">
          <span class="w-12 h-12 flex items-center justify-center rounded-xl bg-[#EC5A00]/10 text-[#EC5A00]" data-ps="src/pages/team.astro:tm-card-icon-2">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </span>
          <h3 class="mt-5 text-lg md:text-xl font-heading font-semibold text-[#020203]" data-ps="src/pages/team.astro:tm-card-title-2">Veteran-Owned</h3>
          <p class="mt-2 text-sm text-[#5a5661] leading-relaxed" data-ps="src/pages/team.astro:tm-card-desc-2">
            Founded by Coast Guard veteran Greg Cooper, we bring service-first values to every home and business across the Tri-Cities.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="p-6 md:p-8 rounded-2xl bg-[#F5F3ED] border border-[#eae6de]" data-ps="src/pages/team.astro:tm-card-3">
          <span class="w-12 h-12 flex items-center justify-center rounded-xl bg-[#EC5A00]/10 text-[#EC5A00]" data-ps="src/pages/team.astro:tm-card-icon-3">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </span>
          <h3 class="mt-5 text-lg md:text-xl font-heading font-semibold text-[#020203]" data-ps="src/pages/team.astro:tm-card-title-3">All Major Brands</h3>
          <p class="mt-2 text-sm text-[#5a5661] leading-relaxed" data-ps="src/pages/team.astro:tm-card-desc-3">
            From senior techs with decades in the field to the newest tools in the van, we repair every major appliance brand the same day, done right.
          </p>
        </div>
      </div>
    </section>

    <!-- Gallery Section -->
    <section class="px-4 md:px-8 py-12 sm:py-16 md:py-24 bg-[#F5F3ED]" data-ps="src/pages/team.astro:tm-gallery-sec">
      <div class="max-w-7xl mx-auto" data-ps="src/pages/team.astro:tm-gallery-wrap">
        <!-- Gallery Header -->
        <div class="text-center mb-8 md:mb-12" data-ps="src/pages/team.astro:tm-gallery-header">
          <div class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-[#FBFAF7] border border-[#eae6de] text-[11px] uppercase tracking-[0.18em] text-[#5a5661] font-medium" data-ps="src/pages/team.astro:tm-gallery-badge">
            <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/pages/team.astro:tm-gallery-dot"></span>
            Gallery
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-5xl font-heading font-semibold tracking-tight text-[#020203] leading-[1.05]" data-ps="src/pages/team.astro:tm-gallery-h2">
            The vans, the tools, <em class="not-italic text-[#EC5A00]">the work.</em>
          </h2>
          <p class="mt-4 text-sm md:text-base text-[#5a5661] max-w-xl mx-auto leading-relaxed" data-ps="src/pages/team.astro:tm-gallery-p">
            No stock photos — a look at our fleet and the appliance repairs we handle every day across the Tri-Cities.
          </p>
        </div>

        <!-- Filter Controls -->
        <div class="flex items-center justify-center gap-2 mb-8 md:mb-10" id="gallery-filters" data-ps="src/pages/team.astro:tm-gallery-filters">
          <button
            type="button"
            data-filter="all"
            class="gallery-filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all cursor-pointer whitespace-nowrap bg-[#EC5A00] text-white shadow-xs"
            data-ps="src/pages/team.astro:tm-filter-all"
          >
            All Photos
          </button>
          <button
            type="button"
            data-filter="fleet"
            class="gallery-filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all cursor-pointer whitespace-nowrap bg-[#FBFAF7] text-[#020203]/80 hover:bg-[#eae6de] border border-[#eae6de]"
            data-ps="src/pages/team.astro:tm-filter-fleet"
          >
            Our Fleet
          </button>
          <button
            type="button"
            data-filter="job"
            class="gallery-filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all cursor-pointer whitespace-nowrap bg-[#FBFAF7] text-[#020203]/80 hover:bg-[#eae6de] border border-[#eae6de]"
            data-ps="src/pages/team.astro:tm-filter-job"
          >
            On the Job
          </button>
        </div>

        <!-- Masonry / Columns Image Grid -->
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-3 md:gap-4" id="gallery-grid" data-ps="src/pages/team.astro:tm-gallery-grid">
          {galleryImages.map((img, idx) => (
            <div
              class="gallery-item mb-3 md:mb-4 block w-full rounded-xl overflow-hidden bg-[#eae6de] group cursor-pointer relative break-inside-avoid shadow-xs transition-opacity duration-300"
              data-category={img.category}
              data-ps={`src/pages/team.astro:tm-gallery-item-${idx}`}
            >
              <img
                alt={img.alt}
                loading="lazy"
                decoding="async"
                class="w-full object-cover transition-transform duration-500 group-hover:scale-105 block"
                src={img.src}
                data-ps={`src/pages/team.astro:tm-gallery-img-${idx}`}
              />
              <div class="absolute inset-0 bg-[#090a0d]/0 group-hover:bg-[#090a0d]/40 transition-colors duration-300 flex items-end justify-start p-4" data-ps={`src/pages/team.astro:tm-gallery-overlay-${idx}`}>
                <span class="text-white text-xs font-medium opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-2 group-hover:translate-y-0 leading-snug drop-shadow-sm" data-ps={`src/pages/team.astro:tm-gallery-caption-${idx}`}>
                  {img.alt}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Careers Section -->
    <section class="px-4 md:px-8 py-12 sm:py-16 md:py-24 bg-[#FBFAF7]" data-ps="src/pages/team.astro:tm-careers-sec">
      <div class="max-w-7xl mx-auto" data-ps="src/pages/team.astro:tm-careers-wrap">
        <!-- Section Header -->
        <div class="text-center mb-10 md:mb-14" data-ps="src/pages/team.astro:tm-careers-header">
          <div class="inline-flex items-center gap-2 mb-4 px-3 py-1 rounded-full bg-[#F5F3ED] border border-[#eae6de] text-[11px] uppercase tracking-[0.18em] text-[#5a5661] font-medium" data-ps="src/pages/team.astro:tm-careers-badge">
            <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/pages/team.astro:tm-careers-dot"></span>
            Careers
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-5xl font-heading font-semibold tracking-tight text-[#020203] leading-[1.05]" data-ps="src/pages/team.astro:tm-careers-h2">
            Join the <em class="not-italic text-[#EC5A00]">UDG Services crew.</em>
          </h2>
          <p class="mt-4 text-sm md:text-base text-[#5a5661] max-w-xl mx-auto leading-relaxed" data-ps="src/pages/team.astro:tm-careers-p">
            We're growing across the Tri-Cities and looking for skilled, reliable people who take pride in honest work. If that sounds like you, let's talk.
          </p>
        </div>

        <!-- 2-Column Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-10 items-start" data-ps="src/pages/team.astro:tm-careers-grid">
          <!-- Left: 4 Job Listing Cards -->
          <div class="lg:col-span-7 space-y-4" data-ps="src/pages/team.astro:tm-jobs-col">
            {jobOpenings.map((job, idx) => (
              <div
                class="p-5 md:p-6 rounded-2xl bg-[#F5F3ED] border border-[#eae6de] hover:border-[#EC5A00]/40 transition-colors shadow-2xs"
                data-ps={`src/pages/team.astro:tm-job-${idx}`}
              >
                <div class="flex items-start gap-4" data-ps={`src/pages/team.astro:a9sl7z-${idx}`}>
                  <!-- Job Icon -->
                  <span class="w-11 h-11 flex items-center justify-center rounded-xl bg-[#EC5A00]/10 text-[#EC5A00] shrink-0" data-ps={`src/pages/team.astro:tm-job-icon-${idx}`}>
                    {job.icon === 'wrench' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                      </svg>
                    )}
                    {job.icon === 'fridge' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                        <line x1="4" y1="10" x2="20" y2="10"></line>
                        <line x1="9" y1="6" x2="9" y2="7"></line>
                        <line x1="9" y1="14" x2="9" y2="16"></line>
                      </svg>
                    )}
                    {job.icon === 'headset' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                        <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                      </svg>
                    )}
                    {job.icon === 'academic' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                      </svg>
                    )}
                  </span>

                  <!-- Job Details -->
                  <div class="flex-1 min-w-0" data-ps={`src/pages/team.astro:a9sl80-${idx}`}>
                    <div class="flex flex-wrap items-center gap-2 mb-1" data-ps={`src/pages/team.astro:a9sl81-${idx}`}>
                      <h3 class="text-base md:text-lg font-heading font-semibold text-[#020203]" data-ps={`src/pages/team.astro:tm-job-title-${idx}`}>
                        {job.title}
                      </h3>
                      <span class="px-2.5 py-0.5 rounded-full bg-[#EC5A00]/10 text-[#EC5A00] text-[11px] font-semibold uppercase tracking-wide" data-ps={`src/pages/team.astro:tm-job-badge-${idx}`}>
                        {job.badge}
                      </span>
                    </div>
