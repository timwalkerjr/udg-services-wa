---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

export const prerender = true;

const title = "Book a Service Visit | Online Appliance Repair Booking | UDG Services";
const description = "Book an appliance repair service visit across Richland, Pasco, Kennewick, and the Tri-Cities. Same-day emergency service available.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Book Appliance Repair Service | UDG Services",
  "image": "https://public.readdy.ai/ai/img_res/fca5f491f55ac01816dd784e81032f29.webp",
  "description": description,
  "url": `${SITE.url}/book/`,
};

const serviceTypes = [
  { value: "Refrigerator or freezer", icon: "fridge" },
  { value: "Washing machine", icon: "washer" },
  { value: "Dryer", icon: "dryer" },
  { value: "Dishwasher", icon: "dishwasher" },
  { value: "Oven or range", icon: "oven" },
  { value: "Microwave", icon: "microwave" },
  { value: "Garbage disposal", icon: "disposal" },
  { value: "Ice maker", icon: "icemaker" },
  { value: "Grill or BBQ", icon: "grill" },
  { value: "Not sure yet", icon: "help" },
];

const propertyTypes = [
  { value: "Single-family home", icon: "home", checked: true },
  { value: "Apartment / Condo", icon: "building" },
  { value: "Small business", icon: "store" },
  { value: "Restaurant", icon: "restaurant" },
  { value: "Office", icon: "briefcase" },
  { value: "Rental property", icon: "key" },
  { value: "Other", icon: "dots" },
];
---

<BaseLayout
  title={title}
  description={description}
  headerVariant="solid"
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-[#FBFAF7] text-[#020203] font-sans" data-ps="src/pages/book.astro:rrr9bm">
    <!-- Hero Banner Section -->
    <section class="px-3 md:px-4 pt-3 md:pt-4" data-ps="src/pages/book.astro:6z4xis">
      <div class="relative w-full min-h-[380px] sm:min-h-[420px] md:min-h-[520px] rounded-2xl md:rounded-3xl overflow-hidden shadow-sm" data-ps="src/pages/book.astro:rrr9bl">
        <img
          alt="West Michigan service van"
          loading="eager"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover object-top"
          src="https://pagesmith-cdn.com/9cf36851/images/83ba72eaa39f34970382465edf09f7ac-db1f77-1536.webp" data-ps="src/pages/book.astro:ua0dn6" />
        <div class="absolute inset-0 bg-gradient-to-b from-[#090a0d]/70 via-[#090a0d]/45 to-[#090a0d]/80 pointer-events-none" data-ps="src/pages/book.astro:rrr9az"></div>
        <div class="relative z-10 flex flex-col justify-end h-full min-h-[380px] sm:min-h-[420px] md:min-h-[520px] max-w-7xl mx-auto w-full px-6 sm:px-8 py-8 sm:py-10 md:py-14" data-ps="src/pages/book.astro:rrr9ay">
          <div class="inline-flex self-start items-center gap-2 mb-4 sm:mb-5 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/25 text-white text-[10px] sm:text-xs uppercase tracking-[0.16em]" data-ps="src/pages/book.astro:rrr9ax">
            <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/pages/book.astro:idxp1f"></span>
            Book online
          </div>
          <h1 class="font-heading font-semibold text-white text-[32px] sm:text-[40px] md:text-[56px] lg:text-[72px] leading-[1.02] tracking-tight max-w-4xl" data-ps="src/pages/book.astro:hfy0xr">
            Book a local<br />
            <em class="not-italic text-[#EC5A00]">service visit.</em>
          </h1>
          <p class="mt-3 sm:mt-4 md:mt-6 max-w-xl text-sm sm:text-base md:text-lg text-white/90 leading-relaxed" data-ps="src/pages/book.astro:axjpd7">
            Takes about a minute. Add a photo if you can — it makes pricing faster.
          </p>
          <div class="mt-5 sm:mt-6 md:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:gap-3" data-ps="src/pages/book.astro:rrr9aw">
            <a
              href="#booking-form"
              class="group inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 rounded-full bg-[#EC5A00] text-white text-sm md:text-base font-semibold hover:bg-[#d45100] transition-all hover:-translate-y-0.5 cursor-pointer whitespace-nowrap shadow-sm no-underline"
             data-ps="src/pages/book.astro:8yqc7x">
              Start booking
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
            <a
              href="/pricing"
              class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 rounded-full bg-white/10 border border-white/25 text-white text-sm md:text-base font-semibold hover:bg-white/20 transition-all cursor-pointer whitespace-nowrap no-underline"
             data-ps="src/pages/book.astro:8yqc7w">
              View pricing
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Booking Form Section -->
    <section id="booking-form" class="px-4 md:px-8 py-12 sm:py-16 md:py-24 bg-[#FBFAF7]" data-ps="src/pages/book.astro:6z4xit">
      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8" data-ps="src/pages/book.astro:rrr9av">
        <!-- Sidebar / Aside -->
        <aside class="lg:col-span-1 space-y-4 order-2 lg:order-1" data-ps="src/pages/book.astro:cpqamx">
          <!-- Booking Progress Card -->
          <div class="p-4 sm:p-5 rounded-2xl bg-[#F5F3ED] border border-[#eae6de] lg:sticky lg:top-24" data-ps="src/pages/book.astro:rrr9au">
            <p class="text-[11px] uppercase tracking-[0.18em] text-[#5a5661] font-semibold" data-ps="src/pages/book.astro:axjpd8">Booking progress</p>
            <div class="mt-4 flex lg:flex-col gap-3 lg:gap-3 overflow-x-auto scroll-clean" data-ps="src/pages/book.astro:rrr9at">
              <div class="flex items-center gap-2 sm:gap-3 shrink-0" data-ps="src/pages/book.astro:rrr9as">
                <span id="step-badge-1" class="w-8 h-8 flex items-center justify-center rounded-full text-xs font-semibold transition-colors shrink-0 bg-[#090a0d] text-white" data-ps="src/pages/book.astro:idxp1g">01</span>
                <span class="text-sm font-medium whitespace-nowrap text-[#020203]" data-ps="src/pages/book.astro:idxp1h">Choose service</span>
              </div>
              <div class="flex items-center gap-2 sm:gap-3 shrink-0" data-ps="src/pages/book.astro:rrr9ar">
                <span id="step-badge-2" class="w-8 h-8 flex items-center justify-center rounded-full text-xs font-semibold transition-colors shrink-0 bg-[#FBFAF7] text-[#71717a] border border-[#eae6de]" data-ps="src/pages/book.astro:idxp1i">02</span>
                <span class="text-sm font-medium whitespace-nowrap text-[#5a5661]" data-ps="src/pages/book.astro:idxp1j">Pick a time</span>
              </div>
              <div class="flex items-center gap-2 sm:gap-3 shrink-0" data-ps="src/pages/book.astro:rrr9aq">
                <span id="step-badge-3" class="w-8 h-8 flex items-center justify-center rounded-full text-xs font-semibold transition-colors shrink-0 bg-[#FBFAF7] text-[#71717a] border border-[#eae6de]" data-ps="src/pages/book.astro:idxp1k">03</span>
                <span class="text-sm font-medium whitespace-nowrap text-[#5a5661]" data-ps="src/pages/book.astro:idxp1l">Your details</span>
              </div>
            </div>

            <div class="hidden lg:block mt-6 pt-6 border-t border-[#eae6de] space-y-3" data-ps="src/pages/book.astro:rrr9a4">
              <p class="text-xs uppercase tracking-[0.18em] text-[#5a5661] font-semibold" data-ps="src/pages/book.astro:axjpd9">Quick tips</p>
              <div class="flex items-start gap-2.5 text-xs text-[#3f3f46] leading-relaxed" data-ps="src/pages/book.astro:rrr9a3">
                <svg class="w-4 h-4 text-[#EC5A00] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
                <span data-ps="src/pages/book.astro:idxp1m">A photo of the issue or access point helps a lot.</span>
              </div>
              <div class="flex items-start gap-2.5 text-xs text-[#3f3f46] leading-relaxed" data-ps="src/pages/book.astro:rrr9a2">
                <svg class="w-4 h-4 text-[#EC5A00] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span data-ps="src/pages/book.astro:idxp1n">City name is enough — no need to share the full address now.</span>
              </div>
              <div class="flex items-start gap-2.5 text-xs text-[#3f3f46] leading-relaxed" data-ps="src/pages/book.astro:rrr9a1">
                <svg class="w-4 h-4 text-[#EC5A00] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <span data-ps="src/pages/book.astro:idxp1o">We'll message you back within a few hours to confirm.</span>
              </div>
            </div>
          </div>

          <!-- Emergency Service Card -->
          <div class="p-4 sm:p-5 rounded-2xl bg-[#090a0d] text-white shadow-sm" data-ps="src/pages/book.astro:rrr9a0">
            <p class="text-xs uppercase tracking-[0.18em] text-[#EC5A00] font-semibold mb-2" data-ps="src/pages/book.astro:axjpda">Emergency?</p>
            <p class="text-sm leading-relaxed text-[#d4d4d8]" data-ps="src/pages/book.astro:axjpdw">
              If your fridge or freezer has stopped cooling, or your oven has quit before a big meal, call us immediately. We offer same-day emergency service across the Tri-Cities.
            </p>
            <a
              href="tel:+15093004042"
              class="mt-4 inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-[#EC5A00] text-white text-sm font-semibold hover:bg-[#d45100] transition-colors cursor-pointer whitespace-nowrap no-underline shadow-sm"
             data-ps="src/pages/book.astro:8yqc7v">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
              </svg>
              (509) 300-4042
            </a>
          </div>
        </aside>

        <!-- Main Booking Form -->
        <form
          id="booking-form-element"
          class="lg:col-span-2 order-1 lg:order-2 rounded-2xl bg-[#FBFAF7] border border-[#eae6de] p-5 sm:p-6 md:p-10 space-y-8 sm:space-y-10 shadow-sm"
        >
          <input type="hidden" name="_formId" value="booking" />

          <!-- Form Status Notification -->
          <div id="form-status" class="hidden px-4 py-3 rounded-xl text-sm font-medium" data-ps="src/pages/book.astro:rrr99z"></div>

          <!-- Section 01: Service Type -->
          <fieldset class="space-y-4">
            <div class="flex items-center justify-between gap-4" data-ps="src/pages/book.astro:rrr99y">
              <div class="flex items-center gap-2.5" data-ps="src/pages/book.astro:rrr99x">
                <span class="w-7 h-7 flex items-center justify-center rounded-full bg-[#090a0d] text-white text-xs font-semibold" data-ps="src/pages/book.astro:udougz">01</span>
                <legend class="text-sm font-heading font-semibold text-[#020203]">What do you need help with?</legend>
              </div>
              <span class="text-[11px] uppercase tracking-wider text-[#71717a] font-medium" data-ps="src/pages/book.astro:udouh0">Tap one</span>
            </div>
            <p class="mt-1 text-sm text-[#5a5661]" data-ps="src/pages/book.astro:axjpdx">Not sure? Pick the closest — you can add detail below.</p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-4" data-ps="src/pages/book.astro:rrr99w">
              {serviceTypes.map((item, __psIdx) => (
                <label class="group flex items-center gap-3 p-3.5 rounded-xl border cursor-pointer transition-all border-[#eae6de] bg-[#FBFAF7] hover:border-[#090a0d]/40 hover:bg-[#F5F3ED] has-[:checked]:border-[#090a0d] has-[:checked]:bg-[#F5F3ED] has-[:checked]:ring-1 has-[:checked]:ring-[#090a0d]" data-ps={`src/pages/book.astro:pnllds-${__psIdx}`}>
                  <input type="radio" name="service_type" value={item.value} required class="sr-only" />
                  <span class="w-9 h-9 flex items-center justify-center rounded-lg text-lg transition-colors shrink-0 bg-[#F5F3ED] text-[#27272a] group-hover:bg-[#eae6de] group-has-[:checked]:bg-[#090a0d] group-has-[:checked]:text-white" data-ps={`src/pages/book.astro:udouh1-${__psIdx}`}>
                    {item.icon === 'fridge' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="4" y1="10" x2="20" y2="10"></line><line x1="9" y1="6" x2="9" y2="7"></line><line x1="9" y1="14" x2="9" y2="16"></line></svg>
                    )}
                    {item.icon === 'washer' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"></rect><circle cx="12" cy="13" r="4"></circle><line x1="7" y1="6" x2="7.01" y2="6"></line><line x1="11" y1="6" x2="13" y2="6"></line></svg>
                    )}
                    {item.icon === 'dryer' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"></path></svg>
                    )}
                    {item.icon === 'dishwasher' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><path d="M8 14h.01M12 14h.01M16 14h.01"></path></svg>
                    )}
                    {item.icon === 'oven' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>
                    )}
                    {item.icon === 'microwave' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    )}
                    {item.icon === 'disposal' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 19 3 15 7 11"></polyline><path d="M21 15a4 4 0 0 0-4-4H3"></path><polyline points="17 5 21 9 17 13"></polyline><path d="M3 9a4 4 0 0 0 4 4h14"></path></svg>
                    )}
                    {item.icon === 'icemaker' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="2" y1="12" x2="22" y2="12"></line><line x1="12" y1="2" x2="12" y2="22"></line><path d="m20 16-4-4 4-4M4 8l4 4-4 4M16 4l-4 4-4-4M8 20l4-4 4 4"></path></svg>
                    )}
                    {item.icon === 'grill' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2M8.5 3.5l1.4 1.4M15.5 3.5l-1.4 1.4M4 10h16M5 10a7 7 0 0 0 14 0M6 18l-2 4M18 18l2 4"></path></svg>
                    )}
                    {item.icon === 'help' && (
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    )}
                  </span>
                  <span class="text-sm text-[#020203] font-medium flex-1" data-ps={`src/pages/book.astro:udouh2-${__psIdx}`}>{item.value}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Section 02: Urgency & Scheduling -->
          <fieldset class="space-y-4">
            <div class="flex items-center justify-between gap-4" data-ps="src/pages/book.astro:rrr99v">
              <div class="flex items-center gap-2.5" data-ps="src/pages/book.astro:rrr999">
                <span class="w-7 h-7 flex items-center justify-center rounded-full bg-[#090a0d] text-white text-xs font-semibold" data-ps="src/pages/book.astro:udouh3">02</span>
                <legend class="text-sm font-heading font-semibold text-[#020203]">When works for you?</legend>
              </div>
              <span class="text-[11px] uppercase tracking-wider text-[#71717a] font-medium" data-ps="src/pages/book.astro:udouh4">Urgency</span>
            </div>

            <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-2" data-ps="src/pages/book.astro:rrr998">
              <!-- Flexible -->
              <label class="group flex items-center gap-3 p-3.5 rounded-xl border cursor-pointer transition-all border-[#eae6de] bg-[#FBFAF7] hover:border-[#090a0d]/40 hover:bg-[#F5F3ED] has-[:checked]:border-[#090a0d] has-[:checked]:bg-[#F5F3ED] has-[:checked]:ring-2 has-[:checked]:ring-[#090a0d]/10" data-ps="src/pages/book.astro:pnlldt">
                <input type="radio" name="urgency" value="Flexible" required class="sr-only" />
                <span class="w-10 h-10 flex items-center justify-center rounded-lg shrink-0 bg-[#F5F3ED] text-[#27272a] group-has-[:checked]:bg-[#EC5A00] group-has-[:checked]:text-white transition-colors" data-ps="src/pages/book.astro:udouh5">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </span>
                <span class="flex flex-col" data-ps="src/pages/book.astro:udouh6">
                  <span class="text-sm font-semibold text-[#020203]" data-ps="src/pages/book.astro:udouh7">Flexible</span>
                  <span class="text-[11px] text-[#71717a]" data-ps="src/pages/book.astro:udouh8">Anytime soon</span>
                </span>
              </label>

              <!-- This week (Checked by default) -->
              <label class="group flex items-center gap-3 p-3.5 rounded-xl border cursor-pointer transition-all border-[#090a0d] bg-[#F5F3ED] ring-2 ring-[#090a0d]/10 has-[:checked]:border-[#090a0d] has-[:checked]:bg-[#F5F3ED] has-[:checked]:ring-2 has-[:checked]:ring-[#090a0d]/10" data-ps="src/pages/book.astro:pnllef">
                <input type="radio" name="urgency" value="This week" checked required class="sr-only" />
                <span class="w-10 h-10 flex items-center justify-center rounded-lg shrink-0 bg-[#EC5A00] text-white transition-colors" data-ps="src/pages/book.astro:udouhu">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                </span>
                <span class="flex flex-col" data-ps="src/pages/book.astro:udouhv">
                  <span class="text-sm font-semibold text-[#020203]" data-ps="src/pages/book.astro:udouhw">This week</span>
                  <span class="text-[11px] text-[#71717a]" data-ps="src/pages/book.astro:udouhx">Within 5 days</span>
                </span>
              </label>

              <!-- As soon as possible -->
              <label class="group flex items-center gap-3 p-3.5 rounded-xl border cursor-pointer transition-all border-[#eae6de] bg-[#FBFAF7] hover:border-[#090a0d]/40 hover:bg-[#F5F3ED] has-[:checked]:border-[#090a0d] has-[:checked]:bg-[#F5F3ED] has-[:checked]:ring-2 has-[:checked]:ring-[#090a0d]/10" data-ps="src/pages/book.astro:pnlleg">
                <input type="radio" name="urgency" value="As soon as possible" required class="sr-only" />
