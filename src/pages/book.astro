                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                      <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    Job description
                  </span>
                  <span id="char-counter" class="normal-case tracking-normal text-[11px] text-[#71717a]" data-ps="src/pages/book.astro:udoujr">0 / 500</span>
                </div>
                <textarea
                  id="job-desc-input"
                  name="job_description"
                  required
                  maxlength="500"
                  rows="4"
                  placeholder="Tell us a bit about the job — access, what's not working, anything we should bring."
                  class="w-full px-4 py-3 rounded-xl bg-[#FBFAF7] border border-[#eae6de] text-sm text-[#020203] placeholder-[#a1a1aa] focus:outline-none focus:border-[#090a0d] focus:ring-2 focus:ring-[#090a0d]/10 transition-all resize-none font-sans"
                ></textarea>
              </label>

              <!-- Add a photo (Full Span) -->
              <div class="sm:col-span-2" data-ps="src/pages/book.astro:jq4xyc">
                <span class="text-xs uppercase tracking-[0.14em] text-[#5a5661] font-semibold flex items-center gap-1.5 mb-2" data-ps="src/pages/book.astro:udoujs">
                  <svg class="w-3.5 h-3.5 text-[#71717a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                    <circle cx="12" cy="13" r="4"></circle>
                  </svg>
                  Add a photo<span class="text-[#71717a] font-normal normal-case tracking-normal" data-ps="src/pages/book.astro:udoujt">— optional but helpful</span>
                </span>
                <button
                  type="button"
                  id="photo-upload-btn"
                  class="w-full flex items-center gap-3 p-4 rounded-xl border-2 border-dashed text-left transition-all cursor-pointer border-[#eae6de] bg-[#F5F3ED] hover:border-[#090a0d]/40 hover:bg-[#FBFAF7]"
                 data-ps="src/pages/book.astro:csitp2">
                  <span class="w-11 h-11 flex items-center justify-center rounded-lg shrink-0 bg-[#FBFAF7] text-[#27272a] shadow-sm" data-ps="src/pages/book.astro:udoukf">
                    <svg class="w-6 h-6 text-[#5a5661]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                  </span>
                  <span class="flex-1 min-w-0" data-ps="src/pages/book.astro:udoukg">
                    <span id="photo-file-label" class="block text-sm font-semibold text-[#020203] truncate" data-ps="src/pages/book.astro:udoukh">Tap to add a photo</span>
                    <span class="block text-xs text-[#5a5661] mt-0.5" data-ps="src/pages/book.astro:udouki">JPG or PNG · from camera or gallery</span>
                  </span>
                </button>
                <input id="photo-file-input" type="file" name="photo" accept="image/*" class="hidden" />
              </div>
            </div>

            <!-- Marketing Consent Checkbox -->
            <label class="mt-6 flex items-start gap-3 p-4 rounded-xl bg-[#F5F3ED] border border-[#eae6de] cursor-pointer" data-ps="src/pages/book.astro:pnllff">
              <input
                type="checkbox"
                name="consent"
                value="agreed"
                required
                class="mt-0.5 w-4 h-4 rounded border-[#eae6de] accent-[#090a0d] cursor-pointer shrink-0"
              />
              <span class="text-xs text-[#3f3f46] leading-relaxed" data-ps="src/pages/book.astro:udoukj">
                I'm happy for UDG Services to contact me about this booking. My details won't be used for marketing.
              </span>
            </label>
          </fieldset>

          <!-- Altcha Widget (Platform Captcha) -->
          <altcha-widget
            challenge="/psapi-internal-v1/altcha/challenge"
            display="invisible"
            auto="onfocus"
          ></altcha-widget>

          <!-- Form Footer Row with Submit Button -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pt-2 border-t border-[#eae6de]/60" data-ps="src/pages/book.astro:jq4xyd">
            <p class="text-xs text-[#71717a] max-w-sm flex items-center gap-1.5 m-0" data-ps="src/pages/book.astro:axjpdy">
              <svg class="w-4 h-4 text-[#EC5A00] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
              You'll get a confirmation once your slot is checked. Usually within a few hours.
            </p>
            <button
              type="submit"
              id="submit-btn"
              class="group inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 rounded-full bg-[#EC5A00] text-white text-sm font-semibold hover:bg-[#d45100] transition-all hover:-translate-y-0.5 cursor-pointer whitespace-nowrap disabled:opacity-60 disabled:cursor-not-allowed shadow-sm"
             data-ps="src/pages/book.astro:kdxbnx">
              <span id="submit-btn-text" data-ps="src/pages/book.astro:udoukk">Book My Appointment</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </section>
  </div>

  <script>
    import 'altcha';

    // Interactive Photo Upload
    const photoBtn = document.getElementById('photo-upload-btn');
    const photoInput = document.getElementById('photo-file-input') as HTMLInputElement;
    const photoLabel = document.getElementById('photo-file-label');

    photoBtn?.addEventListener('click', () => {
      photoInput?.click();
    });

    photoInput?.addEventListener('change', () => {
      if (photoInput.files && photoInput.files.length > 0) {
        const file = photoInput.files[0];
        if (photoLabel) {
          photoLabel.textContent = `${file.name} (${(file.size / 1024).toFixed(0)} KB)`;
        }
      }
    });

    // Character Counter for Job Description
    const jobDescInput = document.getElementById('job-desc-input') as HTMLTextAreaElement;
    const charCounter = document.getElementById('char-counter');

    jobDescInput?.addEventListener('input', () => {
      if (charCounter) {
        charCounter.textContent = `${jobDescInput.value.length} / 500`;
      }
    });

    // Step Progress Highlight
    const stepBadge2 = document.getElementById('step-badge-2');
    const stepBadge3 = document.getElementById('step-badge-3');

    const form = document.getElementById('booking-form-element') as HTMLFormElement;
    const formStatus = document.getElementById('form-status') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitBtnText = document.getElementById('submit-btn-text');

    function updateSteps() {
      const serviceChecked = !!form.querySelector('input[name="service_type"]:checked');
      const dateVal = (form.querySelector('input[name="preferred_date"]') as HTMLInputElement)?.value;
      const timeChecked = !!form.querySelector('input[name="preferred_time"]:checked');

      if (serviceChecked) {
        stepBadge2?.classList.remove('bg-[#FBFAF7]', 'text-[#71717a]');
        stepBadge2?.classList.add('bg-[#090a0d]', 'text-white');
      }
      if (dateVal && timeChecked) {
        stepBadge3?.classList.remove('bg-[#FBFAF7]', 'text-[#71717a]');
        stepBadge3?.classList.add('bg-[#090a0d]', 'text-white');
      }
    }

    form?.addEventListener('change', updateSteps);
    form?.addEventListener('input', updateSteps);

    // Form Submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (submitBtn) submitBtn.disabled = true;
      if (submitBtnText) submitBtnText.textContent = 'Booking appointment...';

      const formData = new FormData(form);

      const payload = {
        _formId: formData.get('_formId') || 'booking',
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        city: formData.get('city'),
        address: formData.get('address') || '',
        service_type: formData.get('service_type'),
        urgency: formData.get('urgency'),
        preferred_date: formData.get('preferred_date'),
        preferred_time: formData.get('preferred_time'),
        property_category: formData.get('property_category'),
        property_type: formData.get('property_type'),
        job_description: formData.get('job_description'),
        consent: formData.get('consent'),
        altcha: formData.get('altcha'),
      };

      try {
        const response = await fetch('/psapi-internal-v1/forms/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (result.success) {
          formStatus.className = 'px-4 py-3 rounded-xl text-sm font-medium bg-emerald-50 border border-emerald-200 text-emerald-800';
          formStatus.innerHTML = `<strong>Appointment Requested!</strong> Thank you ${payload.name || ''}, we have received your booking request and will contact you shortly to confirm.`;
          form.reset();
          if (charCounter) charCounter.textContent = '0 / 500';
          if (photoLabel) photoLabel.textContent = 'Tap to add a photo';
        } else {
          throw new Error(result.error || 'Failed to submit booking. Please try again.');
        }
      } catch (err: any) {
        formStatus.className = 'px-4 py-3 rounded-xl text-sm font-medium bg-red-50 border border-red-200 text-red-800';
        formStatus.textContent = err?.message || 'There was an issue submitting your booking. Please give us a call at (509) 300-4042.';
      } finally {
        formStatus.classList.remove('hidden');
        if (submitBtn) submitBtn.disabled = false;
        if (submitBtnText) submitBtnText.textContent = 'Book My Appointment';
        formStatus.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  </script>
</BaseLayout>
