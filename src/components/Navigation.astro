---
// Navigation matching original exact header layout & scroll behavior with dynamic active link support
export interface Props {
  variant?: 'transparent' | 'solid';
}

const { variant = 'transparent' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'About', href: '/about' },
  { label: 'Team', href: '/team' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Area', href: '/area' },
  { label: 'Contact', href: '/contact' },
];
// ps:header-variant — BaseLayout passes variant="solid" on pages whose source
// shows the header solid at the top; the scroll script below keeps it so.
const headerVariant =
  (Astro.props as { variant?: 'transparent' | 'solid' }).variant ??
  'transparent';

---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent text-white"
  data-header-variant={variant}
  data-ps="src/components/Navigation.astro:dt8k84"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 h-20 flex items-center justify-between" data-ps="src/components/Navigation.astro:gqvsd9">
    <!-- Brand Logo & Wordmark -->
    <a href="/" class="flex items-center gap-3 no-underline group" data-ps="src/components/Navigation.astro:7vkjqn">
      <div class="w-8 h-8 rounded-[6px] bg-[#EC5A00] flex items-center justify-center text-white shadow-sm flex-shrink-0" data-ps="src/components/Navigation.astro:gqvsda">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
        </svg>
      </div>
      <div class="flex flex-col text-left" data-ps="src/components/Navigation.astro:gqvsdb">
        <span id="nav-brand-title" class="font-heading font-semibold text-[16px] leading-tight text-white transition-colors" data-ps="src/components/Navigation.astro:7xpc9m">UDG Services</span>
        <span id="nav-brand-subtitle" class="text-[10px] uppercase tracking-[1.8px] text-white/80 font-medium transition-colors" data-ps="src/components/Navigation.astro:7xpc9l">Tri-Cities · Washington</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden lg:flex items-center gap-1" data-ps="src/components/Navigation.astro:m59h3e">
      {navItems.map((item, __psIdx) => {
        const isActive = item.href === '/' ? pathname === '/' : pathname === item.href || pathname.startsWith(item.href + '/');
        return (
          <a
            href={item.href}
            class={`nav-link text-[14px] font-medium px-3.5 py-2 relative transition-colors no-underline ${
              isActive
                ? 'text-[#EC5A00] font-semibold is-active'
                : 'text-white/90 hover:text-[#EC5A00]'
            }`}
            data-active={isActive ? 'true' : 'false'}
           data-ps={`src/components/Navigation.astro:kd8n5r-${__psIdx}`}>
            {item.label}
            {isActive && (
              <span class="nav-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-5 h-[2px] bg-[#EC5A00] rounded-full" data-ps="src/components/Navigation.astro:i2om69"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Right Controls -->
    <div class="hidden sm:flex items-center gap-5" data-ps="src/components/Navigation.astro:gqvsdc">
      <a
        id="nav-phone-link"
        href="tel:+15093004042"
        class="text-[14px] font-medium text-white hover:text-[#EC5A00] flex items-center gap-2 transition-colors no-underline"
        data-ps="src/components/Navigation.astro:7vkjrh"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
        </svg>
        (509) 300-4042
      </a>
      <a
        href="/book"
        class="bg-[#EC5A00] text-white text-[14px] font-semibold px-4 py-2 rounded-[6px] inline-flex items-center gap-1.5 hover:bg-[#d45100] transition shadow-sm no-underline"
        data-ps="src/components/Navigation.astro:7vkjri"
      >
        Book Service
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="nav-mobile-btn"
      type="button"
      class="lg:hidden p-2 text-white hover:text-[#EC5A00] transition-colors"
      aria-label="Toggle Navigation Menu"
      data-ps="src/components/Navigation.astro:4mv8m"
    >
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown -->
  <div
    id="nav-mobile-menu"
    class="hidden lg:hidden bg-[#FBFAF7] border-b border-[#eae6de] px-6 py-6 text-[#020203] shadow-lg"
    data-ps="src/components/Navigation.astro:gqvsdd"
  >
    <nav class="flex flex-col gap-3 font-medium text-[15px]" data-ps="src/components/Navigation.astro:m59h3d">
      {navItems.map((item, __psIdx) => {
        const isActive = item.href === '/' ? pathname === '/' : pathname === item.href || pathname.startsWith(item.href + '/');
        return (
          <a
            href={item.href}
            class={`py-1 no-underline transition-colors ${
              isActive ? 'text-[#EC5A00] font-semibold' : 'text-foreground hover:text-[#EC5A00]'
            }`}
           data-ps={`src/components/Navigation.astro:kd8n5q-${__psIdx}`}>
            {item.label}
          </a>
        );
      })}
      <div class="pt-4 mt-2 border-t border-[#eae6de] flex flex-col gap-3" data-ps="src/components/Navigation.astro:gqvsde">
        <a href="tel:+15093004042" class="text-foreground font-semibold flex items-center gap-2 no-underline" data-ps="src/components/Navigation.astro:7vkjsc">
          📞 (509) 300-4042
        </a>
        <a href="/book" class="bg-[#EC5A00] text-white text-center py-2.5 rounded-[6px] font-semibold no-underline hover:bg-[#d45100] transition" data-ps="src/components/Navigation.astro:7vkjsd">
          Book Service ↗
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  const header = document.getElementById('main-header');
  const brandTitle = document.getElementById('nav-brand-title');
  const brandSubtitle = document.getElementById('nav-brand-subtitle');
  const phoneLink = document.getElementById('nav-phone-link');
  const navLinks = document.querySelectorAll('.nav-link');
  const mobileBtn = document.getElementById('nav-mobile-btn');
  const mobileMenu = document.getElementById('nav-mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function handleScroll() {
    const isSolid = document.querySelector('header[data-header-variant="solid"]') || window.scrollY > 40;
    if (isSolid) {
      header?.classList.add('bg-[#FBFAF7]/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-[#eae6de]');
      header?.classList.remove('bg-transparent');
      brandTitle?.classList.remove('text-white');
      brandTitle?.classList.add('text-[#020203]');
      brandSubtitle?.classList.remove('text-white/80');
      brandSubtitle?.classList.add('text-[#5a5661]');
      phoneLink?.classList.remove('text-white');
      phoneLink?.classList.add('text-[#020203]');
      mobileBtn?.classList.remove('text-white');
      mobileBtn?.classList.add('text-[#020203]');
      navLinks.forEach((link) => {
        const isActive = link.getAttribute('data-active') === 'true';
        if (!isActive) {
          link.classList.remove('text-white/90');
          link.classList.add('text-[#020203]/80');
        }
      });
    } else {
      header?.classList.remove('bg-[#FBFAF7]/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-[#eae6de]');
      header?.classList.add('bg-transparent');
      brandTitle?.classList.add('text-white');
      brandTitle?.classList.remove('text-[#020203]');
      brandSubtitle?.classList.add('text-white/80');
      brandSubtitle?.classList.remove('text-[#5a5661]');
      phoneLink?.classList.add('text-white');
      phoneLink?.classList.remove('text-[#020203]');
      mobileBtn?.classList.add('text-white');
      mobileBtn?.classList.remove('text-[#020203]');
      navLinks.forEach((link) => {
        const isActive = link.getAttribute('data-active') === 'true';
        if (!isActive) {
          link.classList.add('text-white/90');
          link.classList.remove('text-[#020203]/80');
        }
      });
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  mobileBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');
    if (isHidden) {
      mobileMenu?.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      mobileMenu?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
