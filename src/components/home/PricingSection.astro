---
// Quick Pricing section with pricing guide table
---

<section id="pricing" class="bg-[#F5F3ED] py-24" data-ps="src/components/home/PricingSection.astro:5etcz2">
  <div class="max-w-7xl mx-auto px-6 sm:px-8" data-ps="src/components/home/PricingSection.astro:cpxh5">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start" data-ps="src/components/home/PricingSection.astro:cpxh4">
      <!-- Left Column (5 cols) -->
      <div class="lg:col-span-5" data-ps="src/components/home/PricingSection.astro:cpxh3">
        <div class="inline-flex items-center gap-2 bg-[#FBFAF7] border border-[#E8E4DA] text-xs font-semibold tracking-wider text-muted-foreground uppercase px-3.5 py-1 rounded-full" data-ps="src/components/home/PricingSection.astro:cpxh2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/components/home/PricingSection.astro:qbcle1"></span>
          QUICK PRICING
        </div>
        <h2 class="font-heading text-[36px] sm:text-[48px] font-semibold text-[#09090b] tracking-[-1.2px] leading-tight mt-4" data-ps="src/components/home/PricingSection.astro:uifsug">
          Upfront pricing, <span class="italic text-[#EC5A00]" data-ps="src/components/home/PricingSection.astro:qbcle2">clearly written.</span>
        </h2>
        <p class="text-[16px] text-muted-foreground mt-4 leading-relaxed" data-ps="src/components/home/PricingSection.astro:pil1o3">
          Honest guide prices for local appliance repair in the Tri-Cities. You'll always get a clear repair price before any work begins.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4" data-ps="src/components/home/PricingSection.astro:cpxh1">
          <a
            href="/book"
            class="bg-[#111317] text-white px-6 py-3 rounded-full font-semibold text-sm hover:bg-black transition shadow-sm inline-flex items-center gap-1.5 no-underline"
           data-ps="src/components/home/PricingSection.astro:ien4z5">
            Check Availability
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
          <a
            href="/pricing"
            class="border border-[#d4cfc4] bg-[#FBFAF7] px-6 py-3 rounded-full font-semibold text-sm hover:bg-white transition inline-flex items-center gap-1.5 no-underline text-[#020203]"
           data-ps="src/components/home/PricingSection.astro:ien4z4">
            Full pricing
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column (7 cols) - Table Card -->
      <div class="lg:col-span-7" data-ps="src/components/home/PricingSection.astro:cpxh0">
        <div class="bg-[#FBFAF7] border border-[#E8E4DA] rounded-2xl p-6 sm:p-8 shadow-sm" data-ps="src/components/home/PricingSection.astro:cpxgz">
          <div class="flex items-center justify-between pb-4 border-b border-[#E8E4DA] text-xs font-semibold text-muted-foreground tracking-wider uppercase" data-ps="src/components/home/PricingSection.astro:cpxgy">
            <span data-ps="src/components/home/PricingSection.astro:qbcleo">SERVICE</span>
            <span data-ps="src/components/home/PricingSection.astro:qbclep">FROM</span>
          </div>

          <div class="divide-y divide-[#E8E4DA]" data-ps="src/components/home/PricingSection.astro:cpxgx">
            <!-- Item 1 -->
            <div class="py-5 flex items-start justify-between gap-4" data-ps="src/components/home/PricingSection.astro:cpxgb">
              <div class="flex items-start gap-3" data-ps="src/components/home/PricingSection.astro:cpxga">
                <span class="w-7 h-7 rounded-md bg-[#F5F3ED] text-[#EC5A00] flex items-center justify-center flex-shrink-0 mt-0.5" data-ps="src/components/home/PricingSection.astro:qbcleq">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                  </svg>
                </span>
                <div data-ps="src/components/home/PricingSection.astro:cpxg9">
                  <h3 class="font-heading font-semibold text-[17px] text-[#09090b]" data-ps="src/components/home/PricingSection.astro:fu0vmr">Diagnostic visit</h3>
                  <p class="text-xs sm:text-sm text-muted-foreground mt-1 leading-relaxed" data-ps="src/components/home/PricingSection.astro:pil1o2">
                    A certified technician comes out, diagnoses the fault and gives you an upfront repair price before any work begins.
                  </p>
                </div>
              </div>
              <div class="font-heading font-bold text-[22px] text-[#EC5A00] flex-shrink-0" data-ps="src/components/home/PricingSection.astro:cpxg8">$89</div>
            </div>

            <!-- Item 2 -->
            <div class="py-5 flex items-start justify-between gap-4" data-ps="src/components/home/PricingSection.astro:cpxg7">
              <div class="flex items-start gap-3" data-ps="src/components/home/PricingSection.astro:cpxg6">
                <span class="w-7 h-7 rounded-md bg-[#F5F3ED] text-[#EC5A00] flex items-center justify-center flex-shrink-0 mt-0.5" data-ps="src/components/home/PricingSection.astro:qbcler">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M7 2h10a2 2 0 012 2v16a2 2 0 01-2 2H7a2 2 0 01-2-2V4a2 2 0 012-2zm0 2v7h10V4H7zm0 9v7h10v-7H7z"/>
                  </svg>
                </span>
                <div data-ps="src/components/home/PricingSection.astro:cpxg5">
                  <h3 class="font-heading font-semibold text-[17px] text-[#09090b]" data-ps="src/components/home/PricingSection.astro:fu0vms">Refrigerator & freezer repair</h3>
                  <p class="text-xs sm:text-sm text-muted-foreground mt-1 leading-relaxed" data-ps="src/components/home/PricingSection.astro:pil1o1">
                    Cooling failures, leaks, ice makers and control boards — all major brands. Same-day for emergencies.
                  </p>
                </div>
              </div>
              <div class="font-heading font-bold text-[22px] text-[#EC5A00] flex-shrink-0" data-ps="src/components/home/PricingSection.astro:cpxg4">$149</div>
            </div>

            <!-- Item 3 -->
            <div class="py-5 flex items-start justify-between gap-4" data-ps="src/components/home/PricingSection.astro:cpxg3">
              <div class="flex items-start gap-3" data-ps="src/components/home/PricingSection.astro:cpxg2">
                <span class="w-7 h-7 rounded-md bg-[#F5F3ED] text-[#EC5A00] flex items-center justify-center flex-shrink-0 mt-0.5" data-ps="src/components/home/PricingSection.astro:qbcles">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6 2h12a2 2 0 012 2v16a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2zm6 7a5 5 0 100 10 5 5 0 000-10z"/>
                  </svg>
                </span>
                <div data-ps="src/components/home/PricingSection.astro:ri9dgm">
                  <h3 class="font-heading font-semibold text-[17px] text-[#09090b]" data-ps="src/components/home/PricingSection.astro:fu0vmt">Washer repair</h3>
                  <p class="text-xs sm:text-sm text-muted-foreground mt-1 leading-relaxed" data-ps="src/components/home/PricingSection.astro:pil1nf">
                    Won't drain, won't spin, leaks or error codes. Front-load and top-load machines.
                  </p>
                </div>
              </div>
              <div class="font-heading font-bold text-[22px] text-[#EC5A00] flex-shrink-0" data-ps="src/components/home/PricingSection.astro:ri9dgl">$129</div>
            </div>

            <!-- Item 4 -->
            <div class="py-5 flex items-start justify-between gap-4" data-ps="src/components/home/PricingSection.astro:ri9dgk">
              <div class="flex items-start gap-3" data-ps="src/components/home/PricingSection.astro:ri9dgj">
                <span class="w-7 h-7 rounded-md bg-[#F5F3ED] text-[#EC5A00] flex items-center justify-center flex-shrink-0 mt-0.5" data-ps="src/components/home/PricingSection.astro:qbclet">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                  </svg>
                </span>
                <div data-ps="src/components/home/PricingSection.astro:ri9dgi">
                  <h3 class="font-heading font-semibold text-[oklch(0.090.004260)] text-[18px]" data-ps="src/components/home/PricingSection.astro:fu0vmu">Dryer repair</h3>
                  <p class="text-xs sm:text-sm text-muted-foreground mt-1 leading-relaxed" data-ps="src/components/home/PricingSection.astro:pil1ne">
                    No heat, long dry times or a drum that won't turn. Gas and electric dryers, vent check included.
                  </p>
                </div>
              </div>
              <div class="font-heading font-bold text-[22px] text-[#EC5A00] flex-shrink-0" data-ps="src/components/home/PricingSection.astro:ri9dgh">$129</div>
            </div>

            <!-- Item 5 -->
            <div class="py-5 flex items-start justify-between gap-4" data-ps="src/components/home/PricingSection.astro:ri9dgg">
              <div class="flex items-start gap-3" data-ps="src/components/home/PricingSection.astro:ri9dgf">
                <span class="w-7 h-7 rounded-md bg-[#F5F3ED] text-[#EC5A00] flex items-center justify-center flex-shrink-0 mt-0.5" data-ps="src/components/home/PricingSection.astro:qbcleu">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"/>
                  </svg>
                </span>
                <div data-ps="src/components/home/PricingSection.astro:ri9dge">
                  <h3 class="font-heading font-semibold text-[oklch(0.090.004260)] text-[18px]" data-ps="src/components/home/PricingSection.astro:fu0vmv">Dishwasher repair</h3>
                  <p class="text-xs sm:text-sm text-muted-foreground mt-1 leading-relaxed" data-ps="src/components/home/PricingSection.astro:pil1nd">
                    Not cleaning, not draining or leaking. Built-in, portable and drawer-style models.
                  </p>
                </div>
              </div>
              <div class="font-heading font-bold text-[22px] text-[#EC5A00] flex-shrink-0" data-ps="src/components/home/PricingSection.astro:ri9dgd">$139</div>
            </div>
          </div>

          <p class="text-xs text-muted-foreground mt-6 pt-4 border-t border-[#E8E4DA]" data-ps="src/components/home/PricingSection.astro:pil1nc">
            Prices are guide estimates for local appliance repair. Your technician confirms the exact cost before any work begins.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
