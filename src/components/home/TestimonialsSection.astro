---
// Testimonials section matching screenshot
---

<section id="reviews" class="bg-[#FBFAF7] py-24" data-ps="src/components/home/TestimonialsSection.astro:qihwrj">
  <div class="max-w-7xl mx-auto px-6 sm:px-8" data-ps="src/components/home/TestimonialsSection.astro:z0sjg8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center" data-ps="src/components/home/TestimonialsSection.astro:z0sjg9">
      <!-- Left Column (7 cols) -->
      <div class="lg:col-span-7" data-ps="src/components/home/TestimonialsSection.astro:z0sjga">
        <div class="inline-flex items-center gap-2 bg-[#F5F3ED] border border-[#E8E4DA] text-xs font-semibold tracking-wider text-muted-foreground uppercase px-3.5 py-1 rounded-full" data-ps="src/components/home/TestimonialsSection.astro:z0sjgb">
          <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/components/home/TestimonialsSection.astro:1rkk3w"></span>
          WHAT OUR CUSTOMERS SAY
        </div>

        <div class="mt-6" data-ps="src/components/home/TestimonialsSection.astro:z0sjgc">
          <div class="text-[#EC5A00] text-[72px] font-serif leading-none select-none" data-ps="src/components/home/TestimonialsSection.astro:jgkjpo">“</div>
          <blockquote class="font-heading font-medium text-[26px] sm:text-[34px] lg:text-[40px] leading-tight text-[#09090b] tracking-tight -mt-4">
            Our fridge died on a Friday and they had a tech out the same day. Diagnosed it, quoted the repair upfront, and had it cooling again within the hour. Honest, veteran-owned crew.
          </blockquote>

          <div class="flex flex-wrap items-center gap-4 mt-8" data-ps="src/components/home/TestimonialsSection.astro:jgkjpp">
            <div data-ps="src/components/home/TestimonialsSection.astro:jgkjpq">
              <div class="font-semibold text-base text-[#09090b]" data-ps="src/components/home/TestimonialsSection.astro:jgkjpr">Marcus T.</div>
              <div class="text-xs text-muted-foreground" data-ps="src/components/home/TestimonialsSection.astro:jgkjps">Richland, WA</div>
            </div>
            <div class="h-6 w-[1px] bg-[#E8E4DA]" data-ps="src/components/home/TestimonialsSection.astro:jgkjpt"></div>
            <div class="inline-flex items-center gap-1.5 bg-[#F5F3ED] border border-[#E8E4DA] rounded-full px-3 py-1 text-xs font-semibold text-[#09090b]" data-ps="src/components/home/TestimonialsSection.astro:jgkjpu">
              <span class="text-amber-500" data-ps="src/components/home/TestimonialsSection.astro:1rkk3v">★</span>
              <span data-ps="src/components/home/TestimonialsSection.astro:1rkk39">5.0 · Google Reviews</span>
            </div>
          </div>

          <!-- Carousel Indicator Dots -->
          <div class="flex items-center gap-2 mt-8" data-ps="src/components/home/TestimonialsSection.astro:jgkjpv">
            <span class="w-8 h-2 rounded-full bg-[#111317]" data-ps="src/components/home/TestimonialsSection.astro:1rkk38"></span>
            <span class="w-2 h-2 rounded-full bg-[#d4cfc4]" data-ps="src/components/home/TestimonialsSection.astro:1rkk37"></span>
          </div>
        </div>
      </div>

      <!-- Right Column (5 cols) -->
      <div class="lg:col-span-5" data-ps="src/components/home/TestimonialsSection.astro:jgkjpw">
        <div class="rounded-2xl overflow-hidden shadow-md border border-[#E8E4DA] bg-muted" data-ps="src/components/home/TestimonialsSection.astro:jgkjpx">
          <img
            src="https://pagesmith-cdn.com/9cf36851/images/edited_95ac7533244bd051b17817c51291db0e_538aa613-acd0bf-768.webp"
            alt="Satisfied UDG Services customer in the Tri-Cities"
            class="w-full h-[480px] sm:h-[520px] object-cover"
            loading="lazy" data-ps="src/components/home/TestimonialsSection.astro:wijf4q" />
        </div>
      </div>
    </div>
  </div>
</section>
