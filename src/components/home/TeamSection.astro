---
// Meet the crew section matching screenshot
---

<section id="team" class="bg-[#FBFAF7] py-24 border-t border-[#E8E4DA]" data-ps="src/components/home/TeamSection.astro:ar2i36">
  <div class="max-w-7xl mx-auto px-6 sm:px-8" data-ps="src/components/home/TeamSection.astro:gs7ecp">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center" data-ps="src/components/home/TeamSection.astro:gs7eco">
      <!-- Left Column (6 cols) -->
      <div class="lg:col-span-6" data-ps="src/components/home/TeamSection.astro:gs7ecn">
        <div class="rounded-2xl overflow-hidden shadow-md border border-[#E8E4DA] bg-muted" data-ps="src/components/home/TeamSection.astro:gs7ecm">
          <img
            src="https://pagesmith-cdn.com/9cf36851/images/edited_729d65fc14d2984952030944adea0fe5_cc2a6e75-d8cede-1024.webp"
            alt="UDG Services appliance repair crew in front of their service vans"
            class="w-full h-[440px] sm:h-[480px] object-cover"
            loading="lazy" data-ps="src/components/home/TeamSection.astro:odnoz5" />
        </div>
      </div>

      <!-- Right Column (6 cols) -->
      <div class="lg:col-span-6" data-ps="src/components/home/TeamSection.astro:gs7ecl">
        <div class="inline-flex items-center gap-2 bg-[#F5F3ED] border border-[#E8E4DA] text-xs font-semibold tracking-wider text-muted-foreground uppercase px-3.5 py-1 rounded-full" data-ps="src/components/home/TeamSection.astro:gs7eck">
          <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/components/home/TeamSection.astro:f90px"></span>
          THE PEOPLE BEHIND THE WORK
        </div>
        <h2 class="font-heading text-[36px] sm:text-[48px] font-semibold text-[#09090b] tracking-[-1.2px] leading-tight mt-4" data-ps="src/components/home/TeamSection.astro:uuw4h7">
          Meet the crew keeping <span class="italic text-[#EC5A00]" data-ps="src/components/home/TeamSection.astro:f90py">the Tri-Cities running.</span>
        </h2>
        <p class="text-[16px] sm:text-[17px] text-muted-foreground mt-4 leading-relaxed" data-ps="src/components/home/TeamSection.astro:4f35ow">
          Licensed, insured, and locally based. Founded by Coast Guard veteran Greg Cooper, our team brings military discipline and honest service to every repair call.
        </p>

        <!-- Buttons Row -->
        <div class="mt-8 flex flex-wrap items-center gap-4" data-ps="src/components/home/TeamSection.astro:gs7ecj">
          <a
            href="/team"
            class="bg-[#EC5A00] text-white font-semibold px-6 py-3 rounded-full text-sm hover:bg-[#d45100] transition shadow-sm inline-flex items-center gap-1.5 no-underline"
           data-ps="src/components/home/TeamSection.astro:bj12ej">
            Meet the team
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
          <a
            href="/about"
            class="bg-[#F5F3ED] border border-[#E8E4DA] text-foreground font-medium px-6 py-3 rounded-full text-sm hover:bg-white transition inline-flex items-center gap-1.5 no-underline"
           data-ps="src/components/home/TeamSection.astro:bj12ek">
            Our story
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>

        <!-- Badges -->
        <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-muted-foreground mt-8" data-ps="src/components/home/TeamSection.astro:gs7eci">
          <span class="flex items-center gap-1.5" data-ps="src/components/home/TeamSection.astro:f90pz">
            <svg class="w-4 h-4 text-[#EC5A00]" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Licensed & Insured
          </span>
          <span class="flex items-center gap-1.5" data-ps="src/components/home/TeamSection.astro:f90q0">
            <svg class="w-4 h-4 text-[#EC5A00]" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Veteran-Owned
          </span>
          <span class="flex items-center gap-1.5" data-ps="src/components/home/TeamSection.astro:f90q1">
            <svg class="w-4 h-4 text-[#EC5A00]" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Locally Owned
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
