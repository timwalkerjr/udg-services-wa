---
// Service Areas section with 4 city cards
---

<section id="area" class="bg-[#F5F3ED] py-24" data-ps="src/components/home/AreasSection.astro:557dcb">
  <div class="max-w-7xl mx-auto px-6 sm:px-8" data-ps="src/components/home/AreasSection.astro:i5zwni">
    <!-- Header Row -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6" data-ps="src/components/home/AreasSection.astro:i5zwnj">
      <div class="max-w-2xl" data-ps="src/components/home/AreasSection.astro:i5zwo5">
        <div class="inline-flex items-center gap-2 bg-[#FBFAF7] border border-[#E8E4DA] text-xs font-semibold tracking-wider text-muted-foreground uppercase px-3.5 py-1 rounded-full" data-ps="src/components/home/AreasSection.astro:i5zwo6">
          <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/components/home/AreasSection.astro:4s81qw"></span>
          WHERE WE WORK
        </div>
        <h2 class="font-heading text-[36px] sm:text-[48px] font-semibold text-[#09090b] tracking-[-1.2px] leading-tight mt-3" data-ps="src/components/home/AreasSection.astro:vcehls">
          Serving <span class="text-[#EC5A00]" data-ps="src/components/home/AreasSection.astro:4s81qv">Richland</span> and the wider Tri-Cities.
        </h2>
      </div>
      <div data-ps="src/components/home/AreasSection.astro:i5zwo7">
        <a
          href="/area"
          class="border border-[#d4cfc4] bg-[#FBFAF7] rounded-full px-6 py-2.5 text-sm font-semibold text-[#020203] hover:bg-white transition inline-flex items-center gap-1.5 shadow-2xs no-underline"
         data-ps="src/components/home/AreasSection.astro:1ukmc1">
          See service area
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- 4 Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12" data-ps="src/components/home/AreasSection.astro:i5zwo8">
      <!-- Card 1: Richland -->
      <div class="bg-[#FBFAF7] border border-[#E8E4DA] rounded-2xl overflow-hidden shadow-2xs group flex flex-col justify-between" data-ps="src/components/home/AreasSection.astro:i5zwo9">
        <div class="aspect-[4/3] w-full overflow-hidden bg-muted" data-ps="src/components/home/AreasSection.astro:i5zwoa">
          <img
            src="https://pagesmith-cdn.com/9cf36851/images/869ce6b4272332e8205cc2272d19d881-868f79-320.webp"
            alt="Richland neighbourhood"
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            loading="lazy" data-ps="src/components/home/AreasSection.astro:fnqsbx" />
        </div>
        <div class="p-6" data-ps="src/components/home/AreasSection.astro:i5zwob">
          <div class="flex items-center justify-between" data-ps="src/components/home/AreasSection.astro:i5zwoc">
            <h3 class="font-heading font-semibold text-[19px] text-[#09090b]" data-ps="src/components/home/AreasSection.astro:gnzkdj">Richland</h3>
            <span class="text-[11px] font-semibold text-muted-foreground bg-[#F5F3ED] px-2 py-0.5 rounded" data-ps="src/components/home/AreasSection.astro:4s81q9">WA 99352</span>
          </div>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed" data-ps="src/components/home/AreasSection.astro:8yij13">
            Home base — same-day service available.
          </p>
        </div>
      </div>

      <!-- Card 2: Kennewick -->
      <div class="bg-[#FBFAF7] border border-[#E8E4DA] rounded-2xl overflow-hidden shadow-2xs group flex flex-col justify-between" data-ps="src/components/home/AreasSection.astro:i5zwod">
        <div class="aspect-[4/3] w-full overflow-hidden bg-muted" data-ps="src/components/home/AreasSection.astro:i5zwoe">
          <img
            src="https://pagesmith-cdn.com/9cf36851/images/d503b3c8040f0452c8bfef1691bab5e4-91d99b-320.webp"
            alt="Kennewick neighbourhood"
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            loading="lazy" data-ps="src/components/home/AreasSection.astro:fnqsby" />
        </div>
        <div class="p-6" data-ps="src/components/home/AreasSection.astro:1pe2hy">
          <div class="flex items-center justify-between" data-ps="src/components/home/AreasSection.astro:1pe2hx">
            <h3 class="font-heading font-semibold text-[19px] text-[#09090b]" data-ps="src/components/home/AreasSection.astro:gnzkdk">Kennewick</h3>
            <span class="text-[11px] font-semibold text-muted-foreground bg-[#F5F3ED] px-2 py-0.5 rounded" data-ps="src/components/home/AreasSection.astro:4s81q8">WA 99336</span>
          </div>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed" data-ps="src/components/home/AreasSection.astro:8yij12">
            Residential neighbourhoods and businesses.
          </p>
        </div>
      </div>

      <!-- Card 3: Pasco -->
      <div class="bg-[#FBFAF7] border border-[#E8E4DA] rounded-2xl overflow-hidden shadow-2xs group flex flex-col justify-between" data-ps="src/components/home/AreasSection.astro:1pe2hw">
        <div class="aspect-[4/3] w-full overflow-hidden bg-muted" data-ps="src/components/home/AreasSection.astro:1pe2hv">
          <img
            src="https://pagesmith-cdn.com/9cf36851/images/8c9251cf573c7bf66597622b9e6454eb-c9585a-320.webp"
            alt="Pasco neighbourhood"
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            loading="lazy" data-ps="src/components/home/AreasSection.astro:fnqsbz" />
        </div>
        <div class="p-6" data-ps="src/components/home/AreasSection.astro:1pe2hu">
          <div class="flex items-center justify-between" data-ps="src/components/home/AreasSection.astro:1pe2ht">
            <h3 class="font-heading font-semibold text-[19px] text-[#09090b]" data-ps="src/components/home/AreasSection.astro:gnzke6">Pasco</h3>
            <span class="text-[11px] font-semibold text-muted-foreground bg-[#F5F3ED] px-2 py-0.5 rounded" data-ps="src/components/home/AreasSection.astro:4s81q7">WA 99301</span>
          </div>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed" data-ps="src/components/home/AreasSection.astro:8yij11">
            Fast-growing city, new developments covered.
          </p>
        </div>
      </div>

      <!-- Card 4: Burbank -->
      <div class="bg-[#FBFAF7] border border-[#E8E4DA] rounded-2xl overflow-hidden shadow-2xs group flex flex-col justify-between" data-ps="src/components/home/AreasSection.astro:1pe2hs">
        <div class="aspect-[4/3] w-full overflow-hidden bg-muted" data-ps="src/components/home/AreasSection.astro:1pe2hr">
          <img
            src="https://pagesmith-cdn.com/9cf36851/images/db24afb9529759b291c5884dee2c742b-000c08-320.webp"
            alt="Burbank neighbourhood"
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            loading="lazy" data-ps="src/components/home/AreasSection.astro:fnqsc0" />
        </div>
        <div class="p-6" data-ps="src/components/home/AreasSection.astro:1pe2hq">
          <div class="flex items-center justify-between" data-ps="src/components/home/AreasSection.astro:1pe2hp">
            <h3 class="font-heading font-semibold text-[19px] text-[#09090b]" data-ps="src/components/home/AreasSection.astro:gnzke7">Burbank</h3>
            <span class="text-[11px] font-semibold text-muted-foreground bg-[#F5F3ED] px-2 py-0.5 rounded" data-ps="src/components/home/AreasSection.astro:4s81q6">WA 99323</span>
          </div>
          <p class="text-xs text-muted-foreground mt-2 leading-relaxed" data-ps="src/components/home/AreasSection.astro:8yij10">
            Snake River community — no rural surcharge.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
