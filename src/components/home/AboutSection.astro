---
// About section matching exact screenshot layout, stat counters and van picture
---

<section id="about" class="bg-[#F5F3ED] py-24" data-ps="src/components/home/AboutSection.astro:6hjs5s">
  <div class="max-w-7xl mx-auto px-6 sm:px-8" data-ps="src/components/home/AboutSection.astro:swv5zy">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center" data-ps="src/components/home/AboutSection.astro:swv5zz">
      <!-- Left Column (7 cols) -->
      <div class="lg:col-span-7" data-ps="src/components/home/AboutSection.astro:swv600">
        <div class="inline-flex items-center gap-2 bg-[#FBFAF7] border border-[#E8E4DA] text-xs font-semibold tracking-wider text-muted-foreground uppercase px-3.5 py-1 rounded-full" data-ps="src/components/home/AboutSection.astro:swv601">
          <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/components/home/AboutSection.astro:myvzzx"></span>
          VETERAN-OWNED · LICENSED · INSURED
        </div>
        <h2 class="font-heading text-[36px] sm:text-[48px] font-semibold text-[#09090b] tracking-[-1.2px] leading-tight mt-4" data-ps="src/components/home/AboutSection.astro:tia6la">
          The Tri-Cities' trusted <span class="italic text-[#EC5A00]" data-ps="src/components/home/AboutSection.astro:myvzzy">appliance repair team.</span>
        </h2>
        <p class="text-[16px] sm:text-[17px] text-muted-foreground mt-4 leading-relaxed max-w-2xl" data-ps="src/components/home/AboutSection.astro:bvsbls">
          No call centres, no surprise fees. Just honest, reliable appliance repair by a veteran-owned team that shows up prepared and gets it right the first time.
        </p>

        <!-- Stats Row -->
        <div class="grid grid-cols-3 gap-6 py-6 border-y border-[#E0DCD2] mt-8" data-ps="src/components/home/AboutSection.astro:swv602">
          <div data-ps="src/components/home/AboutSection.astro:swv603">
            <div class="font-heading font-bold text-[32px] sm:text-[40px] text-[#EC5A00] leading-none" data-ps="src/components/home/AboutSection.astro:swv604">90%+</div>
            <p class="text-xs sm:text-sm text-muted-foreground mt-2" data-ps="src/components/home/AboutSection.astro:bvsblt">Repairs completed on the first visit</p>
          </div>
          <div data-ps="src/components/home/AboutSection.astro:swv605">
            <div class="font-heading font-bold text-[32px] sm:text-[40px] text-[#09090b] leading-none" data-ps="src/components/home/AboutSection.astro:swv606">24/7</div>
            <p class="text-xs sm:text-sm text-muted-foreground mt-2" data-ps="src/components/home/AboutSection.astro:bvsblu">Same-day emergency service</p>
          </div>
          <div data-ps="src/components/home/AboutSection.astro:swv607">
            <div class="font-heading font-bold text-[32px] sm:text-[40px] text-[#EC5A00] leading-none" data-ps="src/components/home/AboutSection.astro:ce0hxd">All</div>
            <p class="text-xs sm:text-sm text-muted-foreground mt-2" data-ps="src/components/home/AboutSection.astro:bvsblv">Major appliance brands serviced</p>
          </div>
        </div>

        <!-- Trust Badges List -->
        <div class="flex flex-wrap gap-2.5 mt-8" data-ps="src/components/home/AboutSection.astro:ce0hxe">
          <span class="bg-[#FBFAF7] border border-[#E8E4DA] text-xs font-medium text-[#020203] px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-2xs" data-ps="src/components/home/AboutSection.astro:myvzzz">
            <svg class="w-3.5 h-3.5 text-[#EC5A00]" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Upfront Pricing
          </span>
          <span class="bg-[#FBFAF7] border border-[#E8E4DA] text-xs font-medium text-[#020203] px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-2xs" data-ps="src/components/home/AboutSection.astro:myw000">
            <svg class="w-3.5 h-3.5 text-[#EC5A00]" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            All Major Brands
          </span>
          <span class="bg-[#FBFAF7] border border-[#E8E4DA] text-xs font-medium text-[#020203] px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-2xs" data-ps="src/components/home/AboutSection.astro:myw001">
            <svg class="w-3.5 h-3.5 text-[#EC5A00]" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Veteran-Owned
          </span>
          <span class="bg-[#FBFAF7] border border-[#E8E4DA] text-xs font-medium text-[#020203] px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-2xs" data-ps="src/components/home/AboutSection.astro:myw00n">
            <svg class="w-3.5 h-3.5 text-[#EC5A00]" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Same-Day Emergency Service
          </span>
          <span class="bg-[#FBFAF7] border border-[#E8E4DA] text-xs font-medium text-[#020203] px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-2xs" data-ps="src/components/home/AboutSection.astro:myw00o">
            <svg class="w-3.5 h-3.5 text-[#EC5A00]" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Warranty-Backed Repairs
          </span>
          <span class="bg-[#FBFAF7] border border-[#E8E4DA] text-xs font-medium text-[#020203] px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-2xs" data-ps="src/components/home/AboutSection.astro:myw00p">
            <svg class="w-3.5 h-3.5 text-[#EC5A00]" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Licensed & Insured in WA
          </span>
        </div>
      </div>

      <!-- Right Column (5 cols) -->
      <div class="lg:col-span-5 relative" data-ps="src/components/home/AboutSection.astro:ce0hxf">
        <div class="rounded-2xl overflow-hidden shadow-md border border-[#E8E4DA] bg-muted" data-ps="src/components/home/AboutSection.astro:ce0hxg">
          <img
            src="https://pagesmith-cdn.com/9cf36851/images/edited_22433d633075574f85873ceb52ec10c2_64102400-6a114a-768.webp"
            alt="UDG Services appliance repair team in the Tri-Cities"
            class="w-full h-[520px] object-cover"
            loading="lazy" data-ps="src/components/home/AboutSection.astro:qem1nv" />
        </div>

        <!-- Floating Badge in bottom corner -->
        <div class="absolute bottom-6 left-6 right-6 bg-white/95 backdrop-blur-md border border-[#eae6de] rounded-xl p-4 shadow-lg flex items-center justify-between" data-ps="src/components/home/AboutSection.astro:ce0hxh">
          <div class="flex items-center gap-3" data-ps="src/components/home/AboutSection.astro:ce0hxi">
            <div class="w-8 h-8 rounded-[6px] bg-[#EC5A00] flex items-center justify-center text-white flex-shrink-0" data-ps="src/components/home/AboutSection.astro:ce0hxj">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
              </svg>
            </div>
            <div data-ps="src/components/home/AboutSection.astro:ce0hxk">
              <div class="font-heading font-semibold text-sm text-[#09090b]" data-ps="src/components/home/AboutSection.astro:ce0hxl">UDG Services</div>
              <div class="text-xs text-muted-foreground" data-ps="src/components/home/AboutSection.astro:ce0hxm">Veteran-owned · Tri-Cities, WA</div>
            </div>
          </div>
          <a href="/about" class="w-8 h-8 rounded-full bg-[#111317] text-white flex items-center justify-center hover:bg-[#EC5A00] transition no-underline" data-ps="src/components/home/AboutSection.astro:izq8as">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
