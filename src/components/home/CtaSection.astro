---
// Pre-footer CTA section
---

<section id="cta" class="bg-[#FBFAF7] py-24 text-center" data-ps="src/components/home/CtaSection.astro:l6f4ou">
  <div class="max-w-4xl mx-auto px-6" data-ps="src/components/home/CtaSection.astro:li36ln">
    <div class="inline-flex items-center gap-2 bg-[#F5F3ED] border border-[#E8E4DA] text-xs font-semibold tracking-wider text-muted-foreground uppercase px-3.5 py-1 rounded-full" data-ps="src/components/home/CtaSection.astro:li36lo">
      <span class="w-1.5 h-1.5 rounded-full bg-[#EC5A00]" data-ps="src/components/home/CtaSection.astro:sp82ia"></span>
      READY WHEN YOU ARE
    </div>
    <h2 class="font-heading font-semibold text-[38px] sm:text-[56px] text-[#09090b] tracking-[-1.5px] leading-[1.05] mt-4" data-ps="src/components/home/CtaSection.astro:7zzm9">
      Local appliance repair,<br />
      <span class="italic text-[#EC5A00]" data-ps="src/components/home/CtaSection.astro:sp82i9">just around the corner.</span>
    </h2>
    <p class="text-muted-foreground text-[16px] sm:text-[18px] mt-4 max-w-xl mx-auto leading-relaxed" data-ps="src/components/home/CtaSection.astro:dml3je">
      Book a visit in under a minute — same-day service for emergencies across the Tri-Cities.
    </p>

    <!-- Buttons Row -->
    <div class="flex flex-wrap items-center justify-center gap-4 mt-8" data-ps="src/components/home/CtaSection.astro:li36lp">
      <a
        href="/book"
        class="bg-[#111317] text-white px-7 py-3.5 rounded-full font-semibold text-sm hover:bg-black transition shadow-sm inline-flex items-center gap-1.5 no-underline"
       data-ps="src/components/home/CtaSection.astro:duubk4">
        Book Service
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
      <a
        href="/pricing"
        class="border border-[#d4cfc4] bg-[#FBFAF7] px-7 py-3.5 rounded-full font-semibold text-sm hover:bg-white transition inline-flex items-center gap-1.5 no-underline text-[#020203]"
       data-ps="src/components/home/CtaSection.astro:duubk5">
        View Pricing
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>
