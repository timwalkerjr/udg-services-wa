          <li data-ps="src/components/Footer.astro:wyji4q"><a href="/area" class="hover:text-[#EC5A00] transition-colors no-underline text-[#e4e4e7]" data-ps="src/components/Footer.astro:7gqbyq">Service Area</a></li>
          <li data-ps="src/components/Footer.astro:wyji4r"><a href="/contact" class="hover:text-[#EC5A00] transition-colors no-underline text-[#e4e4e7]" data-ps="src/components/Footer.astro:7gqbyr">Contact</a></li>
        </ul>
      </div>

      <!-- Column 3 (Get in touch) -->
      <div class="lg:col-span-3" data-ps="src/components/Footer.astro:p4vf87">
        <h4 class="font-semibold uppercase tracking-wider mb-4 text-[oklch(0.8950.0180)] text-[12px]" data-ps="src/components/Footer.astro:2uqr9j">Get in touch</h4>
        <ul class="list-none p-0 m-0 space-y-3 text-sm text-[#e4e4e7]">
          <li data-ps="src/components/Footer.astro:wyji4s">
            <a href="tel:+15093004042" class="hover:text-[#EC5A00] transition-colors flex items-center gap-2.5 no-underline text-[#e4e4e7]" data-ps="src/components/Footer.astro:7gqbys">
              <svg class="w-4 h-4 text-[#a1a1aa]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
              </svg>
