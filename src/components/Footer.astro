<footer class="bg-[#090a0d] rounded-t-3xl sm:rounded-t-[32px] mx-2 sm:mx-4 p-8 sm:p-16 text-white relative overflow-hidden mt-16" data-ps="src/components/Footer.astro:7iejvt">
  <!-- Giant Background Faint Watermark -->
  <div class="text-white/[0.03] text-[120px] sm:text-[180px] font-heading font-bold select-none pointer-events-none absolute inset-x-0 bottom-6 text-center whitespace-nowrap leading-none z-0" data-ps="src/components/Footer.astro:256hn2">
