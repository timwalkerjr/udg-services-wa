        <a href="/contact" class="hover:text-white transition-colors no-underline text-[#a1a1aa]" data-ps="src/components/Footer.astro:7gqbyw">Terms</a>
        <a href="/about" class="hover:text-white transition-colors no-underline text-[#a1a1aa]" data-ps="src/components/Footer.astro:7gqbzi">Insurance</a>
