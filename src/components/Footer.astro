          <span class="relative flex h-2.5 w-2.5" data-ps="src/components/Footer.astro:abywyx">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" data-ps="src/components/Footer.astro:abywyy"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500" data-ps="src/components/Footer.astro:abywyz"></span>
          </span>
          Same-day & emergency service
        </div>
      </div>

      <!-- Column 2 (Explore) -->
      <div class="lg:col-span-2" data-ps="src/components/Footer.astro:p4vf86">
        <h4 class="font-semibold uppercase tracking-wider mb-4 text-[oklch(0.8950.0180)] text-[12px]" data-ps="src/components/Footer.astro:2uqr9i">Explore</h4>
        <ul class="list-none p-0 m-0 space-y-2.5 text-sm text-[#e4e4e7]">
          <li data-ps="src/components/Footer.astro:wyji3z"><a href="/services" class="hover:text-[#EC5A00] transition-colors no-underline text-[#e4e4e7]" data-ps="src/components/Footer.astro:7gqbxz">Services</a></li>
          <li data-ps="src/components/Footer.astro:wyji40"><a href="/pricing" class="hover:text-[#EC5A00] transition-colors no-underline text-[#e4e4e7]" data-ps="src/components/Footer.astro:7gqby0">Pricing</a></li>
