      <div class="lg:col-span-3" data-ps="src/components/Footer.astro:p4vf88">
        <h4 class="font-semibold uppercase tracking-wider mb-4 text-[oklch(0.8950.0180)] text-[12px]" data-ps="src/components/Footer.astro:2uqr9k">Book a repair</h4>
        <p class="text-sm text-[#d4d4d8] mb-4" data-ps="src/components/Footer.astro:csf9x">
          Upfront pricing before work begins. Same-day service for emergencies.
        </p>
        <a
          href="/book"
          class="bg-[#EC5A00] text-white px-5 py-2.5 rounded-[6px] font-semibold text-sm w-full inline-block text-center hover:bg-[#d45100] transition shadow-sm no-underline"
         data-ps="src/components/Footer.astro:7gqbyu">
          Book Service ↗
        </a>
        <div class="text-xs text-[#a1a1aa] flex flex-wrap items-center gap-3 mt-4" data-ps="src/components/Footer.astro:p4vf89">
          <span class="flex items-center gap-1" data-ps="src/components/Footer.astro:abywz0">✓ WA License UDGSES*15704</span>
          <span class="flex items-center gap-1" data-ps="src/components/Footer.astro:abywz1">✓ Insured</span>
        </div>
      </div>
