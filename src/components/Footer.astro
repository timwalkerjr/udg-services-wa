  </div>

  <div class="max-w-7xl mx-auto relative z-10" data-ps="src/components/Footer.astro:256hn1">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10" data-ps="src/components/Footer.astro:256hn0">
      <!-- Column 1 (Brand) -->
      <div class="lg:col-span-4 flex flex-col justify-between" data-ps="src/components/Footer.astro:256hmz">
        <div data-ps="src/components/Footer.astro:256hmy">
          <div class="flex items-center gap-3" data-ps="src/components/Footer.astro:p4vf82">
            <div class="w-10 h-10 rounded-[6px] bg-[#EC5A00] flex items-center justify-center text-white shadow-sm flex-shrink-0" data-ps="src/components/Footer.astro:p4vf83">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
              </svg>
