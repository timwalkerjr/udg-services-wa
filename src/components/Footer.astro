            <div class="flex flex-col" data-ps="src/components/Footer.astro:p4vf84">
              <span class="font-heading font-semibold text-lg text-white" data-ps="src/components/Footer.astro:abywyv">UDG Services</span>
              <span class="text-[10px] uppercase tracking-widest text-[#a1a1aa] font-medium" data-ps="src/components/Footer.astro:abywyw">Tri-Cities · Washington</span>
            </div>
          </div>
          <p class="text-sm text-[#d4d4d8] mt-4 leading-relaxed max-w-sm" data-ps="src/components/Footer.astro:csf9w">
            Veteran-owned appliance repair for homes and businesses across the Tri-Cities. All major brands, upfront pricing, warranty-backed repairs.
          </p>
        </div>
